{#
	Title: Page Header
	Description: Hero header section with lead, title, and media
	Category: Headers
	Icon: dashicons-format-image
#}

<div class="block page-header" data-block-id="{{ block.id }}">
	<div class='wrapper'>
		<div class="page-header__container">
			{% if fields.lead %}
				<p class="page-header__lead">{{ fields.lead }}</p>
			{% endif %}

			{% if fields.title %}
				<h1 class="page-header__title">{{ fields.title }}</h1>
			{% endif %}
		</div>

		{% if fields.media_type == 'image' %}
			{% if fields.image %}
				{% set image = TimberImage(fields.image) %}
				<div class="page-header__media page-header__image">
					<img src="{{ image.src }}" alt="{{ fields.title }}"/>
				</div>
			{% endif %}
		{% elseif fields.media_type == 'video' %}
			{% if fields.video %}
				<div class="page-header__media page-header__video">
					<iframe width="100%" height="600" src="{{ fields.video }}" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
				</div>
			{% endif %}
		{% endif %}
	</div>
</div>
