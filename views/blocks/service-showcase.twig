{#
Title: Service Showcase
Description: Display services in a flexible grid layout with features and CTA
Category: common
Icon: dashicons-grid-view
Keywords: services showcase grid
Mode: edit
SupportsMode: false
SupportsMultiple: true
#}

<div class="block-service-showcase">
	{% set services = block.data.services %}
	{% set layout = block.data.layout|default('grid-3') %}
	{% set orderby = block.data.orderby|default('menu_order') %}
	{% set order = block.data.order|default('ASC') %}
	{% set show_price = block.data.show_price %}
	{% set show_features = block.data.show_features %}
	{% set show_cta = block.data.show_cta %}

	{# If no services selected, get all services #}
	{% if not services %}
		{% set services = Timber.get_posts({
			'post_type': 'services',
			'orderby': orderby,
			'order': order,
			'posts_per_page': -1
		}) %}
	{% endif %}

	{% if services %}
		<div class="service-showcase-grid layout-{{ layout }}">
			{% for service in services %}
				<div class="service-card">
					{# Featured Image #}
					{% if service.thumbnail %}
						<div class="service-card__image">
							<img src="{{ service.thumbnail.src('large') }}" alt="{{ service.title }}" loading="lazy" />
						</div>
					{% endif %}

					<div class="service-card__content">
						{# Icon #}
						{% set icon = service.get_field('service_icon') %}
						{% if icon %}
							<div class="service-card__icon">
								<i class="{{ icon }}"></i>
							</div>
						{% endif %}

						{# Title #}
						<h3 class="service-card__title">{{ service.title }}</h3>

						{# Price #}
						{% if show_price %}
							{% set price = service.get_field('service_price') %}
							{% if price %}
								<div class="service-card__price">
									<span class="price">${{ price|number_format(2) }}</span>
								</div>
							{% endif %}
						{% endif %}

						{# Excerpt #}
						<p class="service-card__excerpt">{{ service.excerpt }}</p>

						{# Features #}
						{% if show_features %}
							{% set features = service.get_field('service_features') %}
							{% if features %}
								<ul class="service-card__features">
									{% for feature in features|slice(0, 3) %}
										<li class="service-card__feature-item">
											<span class="feature-icon">✓</span>
											<span class="feature-text">{{ feature.feature_title }}</span>
										</li>
									{% endfor %}
								</ul>
							{% endif %}
						{% endif %}

						{# CTA Button #}
						{% if show_cta %}
							{% set cta_text = service.get_field('service_cta_text')|default('Learn More') %}
							{% set cta_link = service.get_field('service_cta_link')|default(service.link) %}
							<div class="service-card__cta">
								<a href="{{ cta_link }}" class="btn btn-primary">{{ cta_text }}</a>
							</div>
						{% endif %}
					</div>
				</div>
			{% endfor %}
		</div>
	{% else %}
		<p class="notice">No services found. Please select services or add some to your website.</p>
	{% endif %}
</div>
