{#
Title: Pricing / Plans
Description: Display pricing tiers, subscription plans, or service packages with features and CTAs
Category: common
Icon: <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#000" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="1" x2="12" y2="23"></line><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path></svg>
Keywords: Pricing Plans Tiers Subscription Billing
Mode: auto
Align: wide
PostTypes: page post
SupportsAlign: wide full
SupportsMode: true
SupportsMultiple: true
#}

<section id="pricing-{{ block.id }}" class="pricing {{ block.classes }} pricing--{{ fields.layout|default('horizontal') }}">
	<div class="wrapper">
		{% if fields.title %}
			<div class="pricing__header">
				<h2 class="pricing__title">{{ fields.title }}</h2>
				{% if fields.description %}
					<p class="pricing__description">{{ fields.description }}</p>
				{% endif %}
			</div>
		{% endif %}

		{% if fields.plans %}
			{% if fields.layout == 'comparison' %}
				{# Comparison Table View #}
				<div class="pricing__comparison">
					<table class="pricing__table">
						<thead>
							<tr>
								<th class="pricing__table-header pricing__table-header--feature">Feature</th>
								{% for plan in fields.plans %}
									<th class="pricing__table-header{% if plan.featured %} pricing__table-header--featured{% endif %}">
										<div class="pricing__table-plan-name">
											{% if plan.featured %}
												<span class="pricing__badge">Recommended</span>
											{% endif %}
											{{ plan.name }}
										</div>
										<div class="pricing__table-price">
											{{ fields.currency }}{{ plan.price }}
										</div>
										{% if plan.billing %}
											<div class="pricing__table-billing">{{ plan.billing }}</div>
										{% endif %}
									</th>
								{% endfor %}
							</tr>
						</thead>
						<tbody>
							{% if fields.show_features %}
								{# Collect all unique features #}
								{% set all_features = [] %}
								{% for plan in fields.plans %}
									{% for feature in plan.features %}
										{% if feature.text not in all_features %}
											{% set all_features = all_features|merge([feature.text]) %}
										{% endif %}
									{% endfor %}
								{% endfor %}

								{% for feature_name in all_features %}
									<tr class="pricing__table-row">
										<td class="pricing__table-feature">{{ feature_name }}</td>
										{% for plan in fields.plans %}
											<td class="pricing__table-cell{% if plan.featured %} pricing__table-cell--featured{% endif %}">
												{% set feature_included = false %}
												{% for feature in plan.features %}
													{% if feature.text == feature_name and feature.included %}
														{% set feature_included = true %}
													{% endif %}
												{% endfor %}
												{% if feature_included %}
													<i class="fa-solid fa-check pricing__check"></i>
												{% else %}
													<i class="fa-solid fa-times pricing__times"></i>
												{% endif %}
											</td>
										{% endfor %}
									</tr>
								{% endfor %}
							{% endif %}

							{# CTA Row #}
							<tr class="pricing__table-row pricing__table-row--cta">
								<td></td>
								{% for plan in fields.plans %}
									<td class="pricing__table-cell{% if plan.featured %} pricing__table-cell--featured{% endif %}">
										{% if plan.cta %}
											<a href="{{ plan.cta.url }}" class="btn btn--primary" target="{{ plan.cta.target|default('_self') }}">
												{{ plan.cta.title|default('Get Started') }}
											</a>
										{% endif %}
									</td>
								{% endfor %}
							</tr>
						</tbody>
					</table>
				</div>

			{% else %}
				{# Horizontal Card View #}
				<div class="pricing__grid pricing__grid--{{ fields.columns|default(3) }}cols">
					{% for plan in fields.plans %}
						<div class="pricing__item{% if plan.featured %} pricing__item--featured{% endif %}">
							<div class="pricing__card">
								{% if plan.featured %}
									<div class="pricing__badge-container">
										<span class="pricing__badge">Recommended</span>
									</div>
								{% endif %}

								<div class="pricing__plan-header">
									<h3 class="pricing__plan-name">{{ plan.name }}</h3>
									{% if plan.description %}
										<p class="pricing__plan-description">{{ plan.description }}</p>
									{% endif %}
								</div>

								<div class="pricing__price-section">
									<div class="pricing__price">
										<span class="pricing__currency">{{ fields.currency }}</span>
										<span class="pricing__amount">{{ plan.price }}</span>
									</div>
									{% if plan.billing %}
										<p class="pricing__billing">{{ plan.billing }}</p>
									{% endif %}
								</div>

								{% if fields.show_features and plan.features %}
									<div class="pricing__features">
										<ul class="pricing__feature-list">
											{% for feature in plan.features %}
												<li class="pricing__feature-item{% if not feature.included %} pricing__feature-item--unavailable{% endif %}">
													{% if feature.included %}
														<i class="fa-solid fa-check"></i>
													{% else %}
														<i class="fa-solid fa-times"></i>
													{% endif %}
													<span>{{ feature.text }}</span>
												</li>
											{% endfor %}
										</ul>
									</div>
								{% endif %}

								{% if plan.cta %}
									<div class="pricing__cta">
										<a href="{{ plan.cta.url }}" class="btn btn--{{ plan.featured ? 'primary' : 'secondary' }}" target="{{ plan.cta.target|default('_self') }}">
											{{ plan.cta.title|default('Get Started') }}
										</a>
									</div>
								{% endif %}
							</div>
						</div>
					{% endfor %}
				</div>
			{% endif %}
		{% endif %}
	</div>
</section>
