{#
Title: Contact
Description: Display company contact information from theme options with optional custom heading
Category: common
Icon: <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="#fff" stroke="#000" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="feather feather-phone"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
Keywords: Contact, Info, Phone, Email, Address
Mode: auto
Align: wide
PostTypes: page post
SupportsAlign: wide full
SupportsMode: true
SupportsMultiple: true
#}
{% set contact_email = fn('get_field', 'contact_email', 'option') %}
{% set phone_number = fn('get_field', 'phone_number', 'option') %}
{% set address = fn('get_field', 'address', 'option') %}
{% set facebook_url = fn('get_field', 'facebook_url', 'option') %}
{% set twitter_url = fn('get_field', 'twitter_url', 'option') %}
{% set instagram_url = fn('get_field', 'instagram_url', 'option') %}
{% set linkedin_url = fn('get_field', 'linkedin_url', 'option') %}

<section class="contact {{block.classes}}">
	<div class="wrapper">
		{% if fields.title %}
			<h2 class="contact__title">{{ fields.title }}</h2>
		{% endif %}

		<div class="contact__content">
			<!-- Contact Information Column -->
			<div class="contact__column">
				<h3 class="contact__heading">Get In Touch</h3>
				
				<div class="contact__info-list">
					{% if contact_email %}
						<div class="contact__item">
							<svg class="contact__icon" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
								<path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
								<polyline points="22,6 12,13 2,6"></polyline>
							</svg>
							<a href="mailto:{{contact_email}}" class="contact__link">{{ contact_email }}</a>
						</div>
					{% endif %}

					{% if phone_number %}
						<div class="contact__item">
							<svg class="contact__icon" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
								<path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
							</svg>
							<a href="tel:{{phone_number|replace({' ': '', '(': '', ')': '', '-': ''})}}" class="contact__link">{{ phone_number }}</a>
						</div>
					{% endif %}

					{% if address %}
						<div class="contact__item">
							<svg class="contact__icon" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
								<path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
								<circle cx="12" cy="10" r="3"></circle>
							</svg>
							<div class="contact__address">{{ address}}</div>
						</div>
					{% endif %}
				</div>

				<!-- Social Media Links -->
				{% if facebook_url or twitter_url or instagram_url or linkedin_url %}
					<div class="contact__socials">
						<h4 class="contact__socials-title">Follow Us</h4>
						<div class="contact__social-links">
							{% if facebook_url %}
								<a href="{{ facebook_url }}" class="contact__social-link" title="Facebook" target="_blank" rel="noopener noreferrer">
									<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
										<path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"></path>
									</svg>
								</a>
							{% endif %}
							{% if twitter_url %}
								<a href="{{ twitter_url }}" class="contact__social-link" title="Twitter" target="_blank" rel="noopener noreferrer">
									<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
										<path d="M23.953 4.57a10 10 0 002.856-3.515 10 10 0 01-2.956 1.745 5 5 0 00-8.593 4.491 14.05 14.05 0 01-10.176-5.149 5 5 0 001.548 6.686 5 5 0 01-2.265-.567v.06a5 5 0 014.008 4.907 5 5 0 01-2.212.856 5 5 0 004.67 3.48 10 10 0 01-6.177 2.132 14.08 14.08 0 007.557 2.335c9.053 0 13.998-7.496 13.998-13.985 0-.21 0-.42-.015-.63A9.935 9.935 0 0024 4.59z"></path>
									</svg>
								</a>
							{% endif %}
							{% if instagram_url %}
								<a href="{{ instagram_url }}" class="contact__social-link" title="Instagram" target="_blank" rel="noopener noreferrer">
									<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
										<rect x="2" y="2" width="20" height="20" rx="5" ry="5" fill="currentColor"></rect>
										<circle cx="12" cy="12" r="3" fill="white"></circle>
										<circle cx="18" cy="6" r="1.5" fill="white"></circle>
										<rect x="2" y="2" width="20" height="20" rx="5" ry="5" fill="none" stroke="currentColor" stroke-width="2"></rect>
									</svg>
								</a>
							{% endif %}
							{% if linkedin_url %}
								<a href="{{ linkedin_url }}" class="contact__social-link" title="LinkedIn" target="_blank" rel="noopener noreferrer">
									<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
										<path d="M20.447 20.452h-3.554v-5.569c0-1.328-.475-2.236-1.986-2.236-1.081 0-1.722.722-2.004 1.418-.103.249-.129.597-.129.946v5.441h-3.554s.05-8.736 0-9.646h3.554v1.348c-.017.027-.04.053-.066.08h.066v-.08c.42-.649 1.175-1.574 2.865-1.574 2.091 0 3.658 1.362 3.658 4.292v5.58zM5.337 9.433c-1.144 0-1.915-.762-1.915-1.714 0-.952.77-1.713 1.97-1.713 1.199 0 1.916.761 1.938 1.713 0 .952-.739 1.714-1.993 1.714zm1.582 11.019H3.755V9.806h3.164v10.646zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.225 0z"></path>
									</svg>
								</a>
							{% endif %}
						</div>
					</div>
				{% endif %}
			</div>

			<!-- Contact Form Column -->
			<div class="contact__column">
				{% if fields.form_id %}
					<h3 class="contact__heading">Send Us a Message</h3>
					<div class="contact__form">
						{{ fn('do_shortcode', '[contact-form-7 id="' ~ fields.form_id ~ '"]')|raw }}
					</div>
				{% else %}
					<p class="contact__notice">Add a Contact Form 7 form ID to display the contact form.</p>
				{% endif %}
			</div>
		</div>
	</div>
</section>
