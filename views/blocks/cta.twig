{#
Title: Call To Action
Description: A CTA block with centered title, subtitle and up to 2 buttons
Category: common
Icon: <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="#fff" stroke="#000" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="feather feather-zap"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon></svg>
Keywords: CTA, Call To Action, Action
Mode: auto
Align: wide
PostTypes: page post
SupportsAlign: wide full
SupportsMode: true
SupportsMultiple: true
#}
<section id="cta-{{block.id}}" class="cta {{block.classes}}">
	<div class="wrapper cta__wrapper">
		{% if fields.title %}
			<h2 class="cta__title">{{ fields.title }}</h2>
		{% endif %}

		{% if fields.subtitle %}
			<p class="cta__subtitle">{{ fields.subtitle }}</p>
		{% endif %}

		{% if fields.buttons %}
			<div class="cta__buttons">
				{% for button in fields.buttons %}
					{% if button.button_url %}
						<a href="{{ button.button_url }}" class="btn btn--{{ button.button_type|default('primary') }}">
							{{ button.button_label|default('Click Here') }}
						</a>
					{% endif %}
				{% endfor %}
			</div>
		{% endif %}
	</div>
</section>
