{#
Title: Announcement Bar
Description: Rotating announcement slider with optional buttons (non-dismissible)
Category: common
Icon: <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="#fff" stroke="#000" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="feather feather-alert-circle"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
Keywords: Announcement, Banner, Alert, Notification, Slider
Mode: auto
PostTypes: page post
SupportsMode: true
SupportsMultiple: false
#}
<!-- Announcement Bar Slider -->
<div 
	class="announcement announcement--slider {{block.classes}}" 
	data-announcement-id="announcement-{{block.id}}"
	data-total-items="{{fields.announcements|length}}"
>
	<div class="announcement__inner">
		<div class="announcement__slides">
			{% for item in fields.announcements %}
				<div class="announcement__slide {% if loop.first %}is-active{% endif %}" data-slide-index="{{loop.index0}}">
					<div class="announcement__content">
						{% if item.icon %}
							<svg class="announcement__icon" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
								{% if item.icon == 'alert' %}
									<circle cx="12" cy="12" r="10"></circle>
									<line x1="12" y1="8" x2="12" y2="12"></line>
									<line x1="12" y1="16" x2="12.01" y2="16"></line>
								{% elseif item.icon == 'info' %}
									<circle cx="12" cy="12" r="10"></circle>
									<line x1="12" y1="16" x2="12" y2="12"></line>
									<line x1="12" y1="8" x2="12.01" y2="8"></line>
								{% elseif item.icon == 'check' %}
									<polyline points="20 6 9 17 4 12"></polyline>
								{% elseif item.icon == 'star' %}
									<polygon points="12 2 15.09 10.26 23.83 10.5 17.77 16.31 20.16 25.09 12 20.16 3.84 25.09 6.23 16.31 0.17 10.5 8.91 10.26 12 2"></polygon>
								{% endif %}
							</svg>
						{% endif %}

						<div class="announcement__text">
							{{ item.message }}
						</div>
					</div>

					{% if item.button_text and item.button_url %}
						<a href="{{item.button_url}}" class="announcement__button">
							{{ item.button_text }}
						</a>
					{% endif %}
				</div>
			{% endfor %}
		</div>


	</div>
</div>
