{#
Title: Steps / Process Timeline
Description: Process timeline with vertical or horizontal layout, icons, and content
Category: layout
Icon: <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#000" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="feather feather-activity"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"></polyline></svg>
Keywords: Steps, Timeline, Process, Flow, Progress
Mode: auto
Align: wide
PostTypes: page post
SupportsAlign: wide full
SupportsMode: true
SupportsMultiple: true
#}
<!-- Steps / Process Timeline -->
<section class="steps {{block.classes}} steps--{{fields.layout}}">
	<div class="wrapper">
		{% if fields.title or fields.description %}
			<div class="steps__header">
				{% if fields.title %}
					<h2 class="steps__title">{{ fields.title }}</h2>
				{% endif %}
				{% if fields.description %}
					<p class="steps__description">{{ fields.description }}</p>
				{% endif %}
			</div>
		{% endif %}

		<div class="steps__content">
			{% if fields.items %}
				<{% if fields.layout == 'horizontal' %}div{% else %}ol{% endif %} class="steps__list" data-steps-id="{{block.id}}">
					{% for item in fields.items %}
						<li class="steps__item" data-step-index="{{loop.index0}}">
							<!-- Step number badge -->
							<div class="steps__number">
								<span class="steps__number-text">{{ loop.index }}</span>
							</div>

							<!-- Icon if provided -->
							{% if item.icon %}
								<div class="steps__icon">
									{% set icon_img = TimberImage(item.icon) %}
									<img 
										src="{{ icon_img.src }}" 
										alt="{{ item.heading }}"
										width="80"
										height="80"
										loading="lazy"
									>
								</div>
							{% endif %}

							<!-- Step content -->
							<div class="steps__body">
								<h3 class="steps__heading">{{ item.heading }}</h3>
								<div class="steps__text">
									{{ item.content }}
								</div>
							</div>

							<!-- Connector line (horizontal layout) -->
							{% if fields.layout == 'horizontal' and not loop.last %}
								<div class="steps__connector"></div>
							{% endif %}
						</li>
					{% endfor %}
				</{% if fields.layout == 'horizontal' %}div{% else %}>ol{% endif %}>
			{% endif %}
		</div>
	</div>
</section>
