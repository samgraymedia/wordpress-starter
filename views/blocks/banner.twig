{#
Title: Banner
Description: A Custom Banner block
Category: formatting
Icon: <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="#fff" stroke="#000" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="feather feather-calendar"><rect x="3" y="4" width="18" height="18" rx="2" ry="2" fill="#fff"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
Keywords: Banner Block
Mode: auto
Align: center
PostTypes: page post
SupportsAlign: left right center wide full
SupportsMode: true
SupportsMultiple: true
#}
{% if fields.no_image_layout %}
	<div id="banner-{{block.id}}" class="block banner-alt  {{block.classes}}" data-scroll-scale="true">
		<div class="wrapper">
			<div class='banner__content'>
				<h2 class="banner__title">{{ fields.banner_title }}</h2>
				{% include 'components/button.twig' with {
href: fields.button_link,

text: fields.button_text,

class: 'btn--' ~ fields.button_style

        } %}
			</div>
		</div>
	</div>
{% else %}

	<div id="banner-js">
		<div id="banner-{{block.id}}" class="block banner {{block.classes}}" data-scroll-scale="true">
			<div class="wrapper">
				<div class='banner__content'>
					<div class="banner__left">
						<h2 class="banner__title">{{ fields.banner_title }}</h2>


					</div>
					<div class="banner__right"></div>
				</div>
			</div>
			<div class="banner__overlay" style="
																																																																																    width: 100%;
																																																																																    height: 100%;
																																																																																    position: absolute;
																																																																																    top: 0;
																																																																																    background: rgba(0,0,0,0.6);
																																																																																    left: 0;
																																																																																    z-index: 55;
																																																																												transform: scale(0.55, 0.55);
																																																																												transition: transform 0.3s ease-out;
																																																																																"></div>


			<div class='banner__background' style="background-image: url('{{ fields.banner_image.url }}');translate: none; rotate: none; scale: none; transform: scale(0.55, 0.55); opacity: 0.7; transition: transform 0.3s ease-out;"></div>
		</div>
	</div>
{% endif %}
{% if not fields.no_image_layout %}


	<script>
		(function () {
const banner = document.getElementById('banner-js');
if (! banner) 
return;



const bgElement = banner.querySelector('.banner__background');
const overlayElement = banner.querySelector('.banner__overlay');
if (! bgElement) 
return;



const contentEl = document.getElementById('content');
if (! contentEl) 
return;



const minScale = 0.55;
const maxScale = 1;
const scaleStart = 0.2;
const scaleEnd = 0.85;

let isLockedFullScale = false;

function clamp(value, min, max) {
return Math.min(Math.max(value, min), max);
}

function mapRange(value, inMin, inMax, outMin, outMax) {
if (value <= inMin) 
return outMin;



if (value >= inMax) 
return outMax;



const ratio = (value - inMin) / (inMax - inMin);
return outMin + (outMax - outMin) * ratio;
}

function getVisibleProgress() {
const bannerTop = banner.offsetTop;
const bannerHeight = banner.offsetHeight;
const bannerBottom = bannerTop + bannerHeight;

const scrollTop = contentEl.scrollTop;
const viewportHeight = contentEl.offsetHeight;
const viewportBottom = scrollTop + viewportHeight;

const visibleTop = Math.max(bannerTop, scrollTop);
const visibleBottom = Math.min(bannerBottom, viewportBottom);
const visibleAmount = Math.max(0, visibleBottom - visibleTop);

return clamp(visibleAmount / bannerHeight, 0, 1);
}

function applyStyles(progress) {
const scale = minScale + (maxScale - minScale) * progress;
const opacity = 0.7 + (1 - 0.7) * progress;

bgElement.style.transform = `scale(${scale})`;
bgElement.style.opacity = opacity;

if (overlayElement) {
overlayElement.style.transform = `scale(${scale})`;
}
}

function updateScale() {
if (isLockedFullScale) {
applyStyles(1);
return;
}

const visibleProgress = getVisibleProgress();
const progress = mapRange(visibleProgress, scaleStart, scaleEnd, 0, 1);

applyStyles(progress);

if (progress >= 1) {
isLockedFullScale = true;
applyStyles(1);
}
}

contentEl.addEventListener('scroll', updateScale, {passive: true});
updateScale();
})();
	</script>
{% endif %}
