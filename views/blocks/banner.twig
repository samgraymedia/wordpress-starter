<section id="banner-{{block.id}}" class="banner {{block.classes}}{% if fields.background_image %} banner--has-image{% endif %}" {% if fields.background_image %} style="background-image: url('{{ fields.background_image.url }}'); background-size: cover; background-position: center;" {% endif %}>
	 {% if fields.background_image %}<div class="banner__overlay"></div>{% endif %}
	<div class="banner__content wrapper">
		<div class="banner__text">
			{% if fields.title %}
				<h2 class="banner__title">{{ fields.title }}</h2>
			{% endif %}

			{% if fields.subtitle %}
				<p class="banner__subtitle">{{ fields.subtitle }}</p>
			{% endif %}
		</div>
	</div>
</section>
