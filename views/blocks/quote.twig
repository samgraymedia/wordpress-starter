{#
Title: Quote / Pull Quote
Description: Editorial quote with author and attribution
Category: common
Icon: <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#000" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="feather feather-quote"><path d="M3 21c0 0 7-1 7-8V5c0-1.25-4-4-7-4s-4 2.75-4 4c0 5 4 7 4 7s-4 3-4 8s3 4 7 4z"></path><path d="M15 21c0 0 7-1 7-8V5c0-1.25-4-4-7-4s-4 2.75-4 4c0 5 4 7 4 7s-4 3-4 8s3 4 7 4z"></path></svg>
Keywords: Quote, Testimonial, Pull Quote, Citation, Callout
Mode: auto
PostTypes: page post
SupportsMode: true
SupportsMultiple: true
#}
<!-- Quote / Pull Quote -->
<blockquote class="quote {{block.classes}} quote--{{fields.alignment}} quote--{{fields.style}}">
	<div class="quote__content">
		<p class="quote__text">{{ fields.quote }}</p>
		
		{% if fields.author or fields.role %}
			<footer class="quote__footer">
				{% if fields.author %}
					<div class="quote__author">— {{ fields.author }}</div>
				{% endif %}
				{% if fields.role %}
					<div class="quote__role">{{ fields.role }}</div>
				{% endif %}
			</footer>
		{% endif %}
	</div>
</blockquote>
