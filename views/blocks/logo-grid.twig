{#
Title: Logo Grid
Description: Display client logos, partner brands, or accreditations in a responsive grid
Category: common
Icon: <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="#fff" stroke="#000" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="feather feather-grid"><rect x="3" y="3" width="7" height="7"></rect><rect x="14" y="3" width="7" height="7"></rect><rect x="14" y="14" width="7" height="7"></rect><rect x="3" y="14" width="7" height="7"></rect></svg>
Keywords: Logo, Grid, Clients, Partners, Brands
Mode: auto
Align: wide
PostTypes: page post
SupportsAlign: wide full
SupportsMode: true
SupportsMultiple: true
#}
<section id="logo-grid-{{block.id}}" class="logo-grid {{block.classes}} logo-grid--{{fields.columns|default(4)}}cols logo-grid--{{fields.spacing|default('normal')}} {% if fields.greyscale %}logo-grid--greyscale{% endif %}">
	<div class="wrapper">
		{% if fields.title %}
			<div class="logo-grid__header">
				<h2 class="logo-grid__title">{{ fields.title }}</h2>
				{% if fields.description %}
					<p class="logo-grid__description">{{ fields.description }}</p>
				{% endif %}
			</div>
		{% endif %}

		{% if fields.logos %}
			<div class="logo-grid__grid">
				{% for logo in fields.logos %}
					<div class="logo-grid__item">
						{% if logo.link %}
							<a href="{{ logo.link }}" class="logo-grid__link" {% if logo.link_target %}target="_blank" rel="noopener noreferrer"{% endif %}>
								<div class="logo-grid__image-wrapper logo-grid__image-wrapper--{{fields.align|default('center')}}">
									<img src="{{ logo.image }}" alt="{{ logo.alt_text }}" class="logo-grid__image">
								</div>
							</a>
						{% else %}
							<div class="logo-grid__image-wrapper logo-grid__image-wrapper--{{fields.align|default('center')}}">
								<img src="{{ logo.image }}" alt="{{ logo.alt_text }}" class="logo-grid__image">
							</div>
						{% endif %}
					</div>
				{% endfor %}
			</div>
		{% endif %}
	</div>
</section>
