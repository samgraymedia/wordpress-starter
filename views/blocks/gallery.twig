{% import 'macros/lazy-image.twig' as lazy %}

<section id="gallery-{{block.id}}" class="gallery {{block.classes}} gallery--{{fields.columns|default(3)}}cols">
	<div class="wrapper">
		{% if fields.images %}
			<div class="gallery__grid">
				{% for image in fields.images %}
					<div class="gallery__item">
						<div class="gallery__image-wrapper">
							<img 
								data-src="{{ image.url }}" 
								alt="{{ image.alt }}" 
								class="gallery__image"
								loading="lazy"
								decoding="async"
							>
						</div>
						{% if image.caption %}
							<p class="gallery__caption">{{ image.caption }}</p>
						{% endif %}
					</div>
				{% endfor %}
			</div>
		{% endif %}
	</div>
</section>
