{#
Title: Stats / Metrics
Description: Display key statistics, metrics, or achievements (10,000 customers served, 99% uptime, etc.)
Category: common
Icon: <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="#fff" stroke="#000" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="feather feather-bar-chart-2"><line x1="18" y1="20" x2="18" y2="10"></line><line x1="12" y1="20" x2="12" y2="4"></line><line x1="6" y1="20" x2="6" y2="14"></line></svg>
Keywords: Stats, Metrics, Statistics, Numbers, Achievements, Impact
Mode: auto
Align: wide
PostTypes: page post
SupportsAlign: wide full
SupportsMode: true
SupportsMultiple: true
#}

<section id="stats-{{block.id}}" class="stats {{block.classes}} stats--{{fields.layout|default('card')}}">
	<div class="wrapper">
		{% if fields.title %}
			<div class="stats__header">
				<h2 class="stats__title">{{ fields.title }}</h2>
				{% if fields.description %}
					<p class="stats__description">{{ fields.description }}</p>
				{% endif %}
			</div>
		{% endif %}

		{% if fields.stats %}
			<div class="stats__grid stats__grid--{{fields.columns|default(4)}}cols">
				{% for stat in fields.stats %}
					<div class="stats__item">
						{% if fields.layout == 'card' %}
							<div class="stats__card">
								{% if stat.icon %}
									<div class="stats__icon stats__icon--{{stat.color|default('primary')}}">
										<i class="fa-solid {{stat.icon}}"></i>
									</div>
								{% endif %}
								<div class="stats__content">
									<div class="stats__number">{{ stat.number }}</div>
									<h3 class="stats__label">{{ stat.label }}</h3>
									{% if stat.description %}
										<p class="stats__item-description">{{ stat.description }}</p>
									{% endif %}
								</div>
							</div>
						{% else %}
							<div class="stats__minimal">
								{% if stat.icon %}
									<div class="stats__icon stats__icon--{{stat.color|default('primary')}}">
										<i class="fa-solid {{stat.icon}}"></i>
									</div>
								{% endif %}
								<div class="stats__number">{{ stat.number }}</div>
								<h3 class="stats__label">{{ stat.label }}</h3>
								{% if stat.description %}
									<p class="stats__item-description">{{ stat.description }}</p>
								{% endif %}
							</div>
						{% endif %}
					</div>
				{% endfor %}
			</div>
		{% endif %}
	</div>
</section>
