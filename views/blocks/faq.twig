{#
Title: FAQ
Description: FAQ section with questions and answers
Category: design
Icon: <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M13 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9z"/><polyline points="13 2 13 9 20 9"/></svg>
Keywords: faq questions answers
Mode: auto
PostTypes: page
SupportsMode: true
SupportsMultiple: true
#}
<div id="faq-{{block.id}}" class="block faq {{block.classes}}">
	<div class="wrapper">
		{% if fields.title %}
			<span class="faq__lead">{{ fields.lead }}</span>
			<h2 class="faq__title">{{ fields.title }}</h2>
		{% endif %}

		{% if fields.posts %}
			<div class="faq__grid">
				{% for post in fields.posts %}
					{% set faq_answer = fn('get_post_meta', post.ID, 'faq_answer', true) %}
					<div class="faq__item">
						<h3 class="faq__question">{{ post.post_title }}
							<div class="faq__icon">+</div>

						</h3>

						<div class="faq__answer">{{ faq_answer }}</div>
					</div>

				{% endfor %}

			</div>
		{% endif %}
	</div>
</div>
