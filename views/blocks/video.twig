{#
Title: Video
Description: A video block supporting uploaded files or YouTube links with custom player
Category: common
Icon: <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="#fff" stroke="#000" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="feather feather-play-circle"><circle cx="12" cy="12" r="10"></circle><polygon points="10 8 16 12 10 16 10 8"></polygon></svg>
Keywords: Video, Media, YouTube, Upload
Mode: auto
Align: wide
PostTypes: page post
SupportsAlign: wide full
SupportsMode: true
SupportsMultiple: true
#}
<section id="video-{{block.id}}" class="video {{block.classes}}">
	<div class="wrapper">
		{% if fields.title %}
			<h2 class="video__title">{{ fields.title }}</h2>
		{% endif %}

		<div class="video__container" data-video-type="{{fields.video_type|default('file')}}">
			{% if fields.video_type == 'youtube' and fields.youtube_url %}
				<div class="video__player video__player--youtube" data-video-id="{{fields.youtube_url}}">
					<iframe 
						class="video__iframe"
						src="https://www.youtube.com/embed/{{fields.youtube_url}}?rel=0" 
						title="YouTube video: {{ fields.title|default('Video') }}" 
						frameborder="0" 
						allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; fullscreen" 
						allowfullscreen
						aria-label="YouTube video: {{ fields.title|default('Video') }}">
					</iframe>
				</div>
			{% elseif fields.video_file %}
				<div class="video__player video__player--file" data-video-src="{{fields.video_file.url}}">
					<video class="video__element" controls poster="{{fields.poster_image.url|default('')}}">
						<source src="{{ fields.video_file.url }}" type="video/mp4">
						Your browser does not support the video tag.
					</video>
				</div>
			{% endif %}
		</div>

		{% if fields.description %}
			<div class="video__description">
				{{ fields.description }}
			</div>
		{% endif %}
	</div>
</section>
