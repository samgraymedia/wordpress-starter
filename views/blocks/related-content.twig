{#
Title: Related Content / Latest Content
Description: Query-based automatic content block for displaying posts dynamically
Category: common
Icon: <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#000" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path></svg>
Keywords: Related Content Latest Posts Automatic Filter Query
Mode: auto
Align: wide
PostTypes: page post product
SupportsAlign: wide full
SupportsMode: true
SupportsMultiple: true
#}

<section id="related-{{ block.id }}" class="related-content {{ block.classes }}">
	<div class="wrapper">
		{% if fields.title %}
			<div class="related-content__header">
				<h2 class="related-content__title">{{ fields.title }}</h2>
				{% if fields.description %}
					<p class="related-content__description">{{ fields.description }}</p>
				{% endif %}
			</div>
		{% endif %}

		{# Build WP_Query args based on ACF fields #}
		{% set posts_args = {
			'post_type': fields.post_type|default('post'),
			'posts_per_page': fields.items_per_page|default(6),
			'paged': 1,
			'orderby': fields.order_by|default('date') == 'date_desc' ? 'date' : 
						fields.order_by|default('date') == 'date_asc' ? 'date' :
						fields.order_by|default('date') == 'modified' ? 'modified' :
						fields.order_by|default('date') == 'title' ? 'title' :
						fields.order_by|default('date') == 'random' ? 'rand' : 'date',
			'order': fields.order_by|default('date') == 'date_asc' ? 'ASC' : 'DESC',
		} %}

		{# Add taxonomy filter if specified #}
		{% if fields.term and fields.term is not empty %}
			{% set posts_args = posts_args|merge({
				'tax_query': [{
					'taxonomy': fields.taxonomy|default('category'),
					'field': 'slug',
					'terms': [fields.term]
				}]
			}) %}
		{% elseif fields.taxonomy and fields.taxonomy is not empty %}
			{# Alternative: filter by taxonomy without specific term #}
		{% endif %}

		{# Exclude current post if enabled #}
		{% if fields.exclude_current and post %}
			{% set posts_args = posts_args|merge({
				'post__not_in': [post.ID]
			}) %}
		{% endif %}

		{# Get posts using Timber #}
		{% set posts = TimberPost.query(posts_args) %}

		{% if posts %}
			<div class="related-content__items" style="--columns: {{ fields.columns|default(3) }}">
				{% for post in posts %}
					<article class="related-content__item">
						{% if fields.show_image and post.thumbnail %}
							<div class="related-content__image">
								<a href="{{ post.link }}" target="{{ fields.link_target|default('_self') }}" class="related-content__image-link">
									<img 
										src="{{ post.thumbnail.src }}" 
										alt="{{ post.thumbnail.alt|default(post.title) }}"
										class="related-content__img"
										loading="lazy"
									/>
								</a>
							</div>
						{% endif %}

						<div class="related-content__content">
							{% if fields.show_date %}
								<div class="related-content__meta">
									<time datetime="{{ post.date|date('c') }}" class="related-content__date">
										{{ post.date|date('M d, Y') }}
									</time>
									{% if post.author %}
										<span class="related-content__author">by {{ post.author.name }}</span>
									{% endif %}
								</div>
							{% endif %}

							<h3 class="related-content__title-item">
								<a href="{{ post.link }}" target="{{ fields.link_target|default('_self') }}" class="related-content__link">
									{{ post.title }}
								</a>
							</h3>

							{% if fields.show_excerpt and post.excerpt %}
								<p class="related-content__excerpt">
									{{ post.excerpt|truncate(150) }}
								</p>
							{% endif %}

							<a href="{{ post.link }}" target="{{ fields.link_target|default('_self') }}" class="related-content__read-more">
								Read More
								<i class="fa-solid fa-arrow-right"></i>
							</a>
						</div>
					</article>
				{% endfor %}
			</div>
		{% else %}
			<div class="related-content__empty">
				<p>No posts found matching the criteria.</p>
			</div>
		{% endif %}
	</div>
</section>
