{#
Title: Slider / Carousel
Description: A responsive carousel/slider with images, titles, and descriptions
Category: common
Icon: <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="#fff" stroke="#000" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="feather feather-play"><polygon points="5 3 19 12 5 21 5 3"></polygon></svg>
Keywords: Slider, Carousel, Hero, Banner
Mode: auto
Align: wide
PostTypes: page post
SupportsAlign: wide full
SupportsMode: true
SupportsMultiple: true
#}
<section id="slider-{{block.id}}" class="slider {{block.classes}}" data-autoplay="{{fields.autoplay|default(true)}}" data-interval="{{fields.interval|default(5000)}}">
	<div class="slider__wrapper">
		{% if fields.slides %}
			<div class="slider__track">
				{% for slide in fields.slides %}
					<div class="slider__slide" data-index="{{loop.index0}}">
						{% if slide.image %}
							<img data-src="{{ slide.image.url }}" alt="{{ slide.image.alt }}" class="slider__img" loading="lazy" decoding="async">
						{% endif %}

						{% if slide.overlay %}
							<div class="slider__overlay"></div>
						{% endif %}

						<div class="slider__content-wrapper">
							{% if slide.title or slide.description or slide.button_url %}
								<div class="slider__content">
									<div class="slider__text">
										{% if slide.title %}
											<h2 class="slider__title">{{ slide.title }}</h2>
										{% endif %}

										{% if slide.description %}
											<p class="slider__description">{{ slide.description }}</p>
										{% endif %}

										{% if slide.button_url %}
											<a href="{{ slide.button_url }}" class="btn btn--{{ slide.button_style|default('primary') }}">
												{{ slide.button_text|default('Learn More') }}
											</a>
										{% endif %}
									</div>
								</div>
							{% endif %}
						</div>
					</div>
				{% endfor %}
			</div>

			{% if fields.slides|length > 1 %}
				<button class="slider__nav slider__nav--prev" aria-label="Previous slide">
					<span>‹</span>
				</button>
				<button class="slider__nav slider__nav--next" aria-label="Next slide">
					<span>›</span>
				</button>

				<div class="slider__indicators">
					{% for slide in fields.slides %}
						<button class="slider__dot {% if loop.first %}active{% endif %}" data-index="{{loop.index0}}" aria-label="Go to slide {{loop.index}}"></button>
					{% endfor %}
				</div>
			{% endif %}
		{% endif %}
	</div>
</section>
