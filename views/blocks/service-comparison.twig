{#
Title: Service Comparison
Description: Compare multiple services side-by-side with feature comparison table or cards
Category: common
Icon: dashicons-feedback
Keywords: services comparison features
Mode: edit
SupportsMode: false
SupportsMultiple: true
#}

<div class="block-service-comparison">
	{% set services = block.data.services %}
	{% set layout = block.data.layout|default('table') %}
	{% set highlight = block.data.highlight %}
	{% set best_choice_service = block.data.best_choice %}

	{% if services %}
		<div class="service-comparison-wrapper layout-{{ layout }}">
			{% if layout == 'table' %}
				{# Table Layout #}
				<div class="service-comparison-table-container">
					<table class="service-comparison-table">
						<thead>
							<tr>
								<th class="comparison-feature">Feature</th>
								{% for service in services %}
									<th class="comparison-service">
										<div class="service-header">
											{% if highlight and best_choice_service and best_choice_service.id == service.id %}
												<div class="badge badge-best-choice">Most Popular</div>
											{% endif %}
											<h4>{{ service.title }}</h4>
											{% set price = service.get_field('service_price') %}
											{% if price %}
												<div class="service-price">${{ price|number_format(2) }}</div>
											{% endif %}
										</div>
									</th>
								{% endfor %}
							</tr>
						</thead>
						<tbody>
							{% set features = block.data.features %}
							{% if features %}
								{% for feature in features %}
									<tr class="comparison-row">
										<td class="comparison-feature">{{ feature.feature_name }}</td>
										{% for service in services %}
											<td class="comparison-value">
												<span class="check-mark">✓</span>
											</td>
										{% endfor %}
									</tr>
								{% endfor %}
							{% endif %}

							{# Service Features Row #}
							<tr class="comparison-row features-row">
								<td class="comparison-feature"><strong>Key Features</strong></td>
								{% for service in services %}
									<td class="comparison-value">
										<ul class="feature-list">
											{% set service_features = service.get_field('service_features') %}
											{% if service_features %}
												{% for feature in service_features|slice(0, 3) %}
													<li>{{ feature.feature_title }}</li>
												{% endfor %}
											{% endif %}
										</ul>
									</td>
								{% endfor %}
							</tr>

							{# CTA Row #}
							<tr class="comparison-row cta-row">
								<td class="comparison-feature"></td>
								{% for service in services %}
									<td class="comparison-value">
										{% set cta_text = service.get_field('service_cta_text')|default('Choose') %}
										{% set cta_link = service.get_field('service_cta_link')|default(service.link) %}
										<a href="{{ cta_link }}" class="btn btn-primary">{{ cta_text }}</a>
									</td>
								{% endfor %}
							</tr>
						</tbody>
					</table>
				</div>

			{% elseif layout == 'cards' %}
				{# Cards Layout #}
				<div class="service-comparison-cards">
					{% for service in services %}
						<div class="comparison-card {% if highlight and best_choice_service and best_choice_service.id == service.id %}is-featured{% endif %}">
							{% if highlight and best_choice_service and best_choice_service.id == service.id %}
								<div class="badge badge-best-choice">Most Popular</div>
							{% endif %}

							<h3>{{ service.title }}</h3>

							{% set price = service.get_field('service_price') %}
							{% if price %}
								<div class="card-price">${{ price|number_format(2) }}</div>
							{% endif %}

							<div class="card-features">
								{% set service_features = service.get_field('service_features') %}
								{% if service_features %}
									<ul>
										{% for feature in service_features %}
											<li>{{ feature.feature_title }}</li>
										{% endfor %}
									</ul>
								{% endif %}
							</div>

							{% set cta_text = service.get_field('service_cta_text')|default('Choose') %}
							{% set cta_link = service.get_field('service_cta_link')|default(service.link) %}
							<a href="{{ cta_link }}" class="btn btn-primary btn-block">{{ cta_text }}</a>
						</div>
					{% endfor %}
				</div>

			{% elseif layout == 'accordion' %}
				{# Accordion Layout #}
				<div class="service-comparison-accordion">
					{% for service in services %}
						<div class="accordion-item {% if highlight and best_choice_service and best_choice_service.id == service.id %}is-featured{% endif %}">
							<h3 class="accordion-header">
								<button class="accordion-button" data-bs-toggle="collapse" data-bs-target="#service-{{ service.id }}">
									<span>{{ service.title }}</span>
									{% set price = service.get_field('service_price') %}
									{% if price %}
										<span class="ms-auto">${{ price|number_format(2) }}</span>
									{% endif %}
								</button>
							</h3>
							<div id="service-{{ service.id }}" class="accordion-collapse collapse" data-bs-parent=".service-comparison-accordion">
								<div class="accordion-body">
									{% set service_features = service.get_field('service_features') %}
									{% if service_features %}
										<ul class="feature-list">
											{% for feature in service_features %}
												<li>{{ feature.feature_title }}</li>
											{% endfor %}
										</ul>
									{% endif %}

									{% set cta_text = service.get_field('service_cta_text')|default('Choose') %}
									{% set cta_link = service.get_field('service_cta_link')|default(service.link) %}
									<a href="{{ cta_link }}" class="btn btn-primary mt-3">{{ cta_text }}</a>
								</div>
							</div>
						</div>
					{% endfor %}
				</div>
			{% endif %}
		</div>
	{% else %}
		<p class="notice">Please select services to compare.</p>
	{% endif %}
</div>
