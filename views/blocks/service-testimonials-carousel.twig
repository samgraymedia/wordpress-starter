{#
Title: Service Testimonials Carousel
Description: Display testimonials in a carousel, grid, or rotating format
Category: common
Icon: dashicons-format-quote
Keywords: testimonials carousel slider testimonial review
Mode: edit
SupportsMode: false
SupportsMultiple: true
#}

<div class="block-service-testimonials-carousel" data-layout="{{ block.data.layout|default('slider') }}">
	{% set service = block.data.service %}
	{% set limit = block.data.limit|default(6) %}
	{% set layout = block.data.layout|default('slider') %}
	{% set columns = block.data.columns|default('1') %}
	{% set show_rating = block.data.show_rating %}
	{% set show_author = block.data.show_author %}
	{% set show_location = block.data.show_location %}
	{% set autoplay = block.data.autoplay %}
	{% set autoplay_delay = block.data.autoplay_delay|default(5) %}

	{% set query_args = {
		'post_type': 'testimonials',
		'posts_per_page': limit > 0 ? limit : -1,
		'orderby': 'date',
		'order': 'DESC',
	} %}

	{# Filter by service if selected #}
	{% if service %}
		{% set query_args = query_args|merge({
			'meta_query': [
				{
					'key': 'related_service',
					'value': service.id,
					'compare': '='
				}
			]
		}) %}
	{% endif %}

	{% set testimonials = Timber.get_posts(query_args) %}

	{% if testimonials %}
		{% if layout == 'slider' %}
			{# Carousel/Slider Layout #}
			<div class="testimonials-carousel" 
				 data-autoplay="{{ autoplay ? 'true' : 'false' }}"
				 data-autoplay-delay="{{ autoplay_delay * 1000 }}">
				
				<div class="carousel-items">
					{% for testimonial in testimonials %}
						<div class="carousel-item" data-index="{{ loop.index0 }}">
							<div class="testimonial-card">
								{# Rating #}
								{% if show_rating %}
									{% set rating = testimonial.get_field('testimonial_rating')|default(5) %}
									<div class="testimonial-rating">
										{% for i in 1..rating %}
											<span class="star">★</span>
										{% endfor %}
									</div>
								{% endif %}

								{# Quote #}
								<p class="testimonial-quote">{{ testimonial.get_field('testimonial_text') }}</p>

								{# Author Info #}
								{% if show_author or show_location %}
									<div class="testimonial-author">
										{% if show_author %}
											<strong class="author-name">{{ testimonial.title }}</strong>
										{% endif %}
										{% if show_location %}
											{% set location = testimonial.get_field('testimonial_location') %}
											{% if location %}
												<small class="author-location">{{ location }}</small>
											{% endif %}
										{% endif %}
									</div>
								{% endif %}
							</div>
						</div>
					{% endfor %}
				</div>

				{# Navigation #}
				<div class="carousel-navigation">
					<button class="carousel-prev" aria-label="Previous testimonial">
						<span>‹</span>
					</button>
					<div class="carousel-indicators">
						{% for i in 0..testimonials|length - 1 %}
							<button class="indicator {% if i == 0 %}is-active{% endif %}" 
									data-slide="{{ i }}"
									aria-label="Go to testimonial {{ i + 1 }}">
							</button>
						{% endfor %}
					</div>
					<button class="carousel-next" aria-label="Next testimonial">
						<span>›</span>
					</button>
				</div>
			</div>

		{% elseif layout == 'grid' %}
			{# Grid Layout #}
			<div class="testimonials-grid columns-{{ columns }}">
				{% for testimonial in testimonials %}
					<div class="testimonial-card-grid">
						{# Rating #}
						{% if show_rating %}
							{% set rating = testimonial.get_field('testimonial_rating')|default(5) %}
							<div class="testimonial-rating">
								{% for i in 1..rating %}
									<span class="star">★</span>
								{% endfor %}
							</div>
						{% endif %}

						{# Quote #}
						<p class="testimonial-quote">{{ testimonial.get_field('testimonial_text')|slice(0, 200) }}{% if testimonial.get_field('testimonial_text')|length > 200 %}...{% endif %}</p>

						{# Author Info #}
						{% if show_author or show_location %}
							<div class="testimonial-author">
								{% if show_author %}
									<strong class="author-name">{{ testimonial.title }}</strong>
								{% endif %}
								{% if show_location %}
									{% set location = testimonial.get_field('testimonial_location') %}
									{% if location %}
										<small class="author-location">{{ location }}</small>
									{% endif %}
								{% endif %}
							</div>
						{% endif %}
					</div>
				{% endfor %}
			</div>

		{% elseif layout == 'single' %}
			{# Single Rotating Layout #}
			<div class="testimonials-single" 
				 data-autoplay="true"
				 data-autoplay-delay="{{ autoplay_delay * 1000 }}">
				
				{% set random_testimonial = testimonials|random %}
				<div class="testimonial-card-single">
					{# Rating #}
					{% if show_rating %}
						{% set rating = random_testimonial.get_field('testimonial_rating')|default(5) %}
						<div class="testimonial-rating">
							{% for i in 1..rating %}
								<span class="star">★</span>
							{% endfor %}
						</div>
					{% endif %}

					{# Quote #}
					<p class="testimonial-quote">{{ random_testimonial.get_field('testimonial_text') }}</p>

					{# Author Info #}
					{% if show_author or show_location %}
						<div class="testimonial-author">
							{% if show_author %}
								<strong class="author-name">{{ random_testimonial.title }}</strong>
							{% endif %}
							{% if show_location %}
								{% set location = random_testimonial.get_field('testimonial_location') %}
								{% if location %}
									<small class="author-location">{{ location }}</small>
								{% endif %}
							{% endif %}
						</div>
					{% endif %}
				</div>

				{# Navigation buttons #}
				<div class="single-navigation">
					<button class="btn-prev">← Previous</button>
					<button class="btn-next">Next →</button>
				</div>
			</div>
		{% endif %}
	{% else %}
		<p class="notice">
			{% if service %}
				No testimonials found for this service. Add some testimonials related to this service.
			{% else %}
				No testimonials found. Please add testimonials first.
			{% endif %}
		</p>
	{% endif %}
</div>
