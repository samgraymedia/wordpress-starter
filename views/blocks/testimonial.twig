{#
Title: Testimonial / Reviews
Description: Display customer testimonials, reviews, and success stories
Category: common
Icon: <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#000" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path></svg>
Keywords: Testimonial Review Quote Customer
Mode: auto
Align: wide full
PostTypes: page post
SupportsAlign: wide full
SupportsMode: true
SupportsMultiple: true
#}

<section id="testimonial-{{ block.id }}" class="testimonial {{ block.classes }} testimonial--{{ fields.layout|default('grid') }}">
	<div class="wrapper">
		{% if fields.title %}
			<div class="testimonial__header">
				<h2 class="testimonial__title">{{ fields.title }}</h2>
				{% if fields.description %}
					<p class="testimonial__description">{{ fields.description }}</p>
				{% endif %}
			</div>
		{% endif %}

		{% if fields.testimonials %}
			{% if fields.layout == 'carousel' %}
				<div class="testimonial__carousel" data-autoplay="{{ fields.autoplay ? 'true' : 'false' }}" role="region" aria-label="Customer testimonials carousel" aria-live="polite">
					<div role="status" aria-live="polite" aria-atomic="true" class="sr-only" id="carousel-{{ block.id }}-status"></div>
					
					{% if fields.autoplay %}
						<button class="testimonial__control testimonial__control--pause-play" aria-label="Pause carousel" aria-pressed="false" id="carousel-{{ block.id }}-pause" type="button">
							<span class="sr-only">Pause carousel autoplay</span>
							<span aria-hidden="true">⏸</span>
						</button>
					{% endif %}

					<div class="testimonial__carousel-track" role="presentation">
						{% for testimonial in fields.testimonials %}
							<div class="testimonial__slide" role="group" aria-roledescription="slide" aria-label="Slide {{ loop.index }} of {{ fields.testimonials|length }}">
								<div class="testimonial__card">
									<blockquote class="testimonial__quote">
										{{ testimonial.post_excerpt|wp_strip_all_tags|truncate(220) }}
									</blockquote>

									{% if fields.show_rating %}
										<div class="testimonial__rating" aria-label="Rating: 5 out of 5 stars">
											<span class="testimonial__stars" aria-hidden="true">★★★★★</span>
										</div>
									{% endif %}

									{% if fields.show_author %}
										<div class="testimonial__author">
											{% if fields.show_image and testimonial.thumbnail %}
												<div class="testimonial__image">
													{{ testimonial.thumbnail }}
												</div>
											{% endif %}
											<div class="testimonial__author-info">
												<p class="testimonial__author-name">{{ testimonial.post_title }}</p>
											</div>
										</div>
									{% endif %}
								</div>
							</div>
						{% endfor %}
					</div>

					<div class="testimonial__carousel-controls">
					<button class="testimonial__control testimonial__control--prev" aria-label="View previous testimonial" type="button">
						<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><polyline points="15 18 9 12 15 6"></polyline></svg>
					</button>
					<button class="testimonial__control testimonial__control--next" aria-label="View next testimonial" type="button">
						<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><polyline points="9 18 15 12 9 6"></polyline></svg>
						</button>
					</div>
				</div>

			{% elseif fields.layout == 'list' %}
				<div class="testimonial__list">
					{% for testimonial in fields.testimonials %}
						<div class="testimonial__item testimonial__item--list">
							<div class="testimonial__item-main">
								{% if fields.show_image and testimonial.thumbnail %}
									<div class="testimonial__image testimonial__image--list">
										{{ testimonial.thumbnail }}
									</div>
								{% endif %}

								<blockquote class="testimonial__quote">
									{{ testimonial.post_excerpt|wp_strip_all_tags|truncate(250) }}
								</blockquote>
							</div>

							<div class="testimonial__item-meta">
								{% if fields.show_rating %}
									<div class="testimonial__rating" aria-label="Rating: 5 out of 5 stars">
										<span class="testimonial__stars" aria-hidden="true">★★★★★</span>
									</div>
								{% endif %}

								{% if fields.show_author %}
									<p class="testimonial__author-name">{{ testimonial.post_title }}</p>
								{% endif %}
							</div>
						</div>
					{% endfor %}
				</div>

			{% else %}
				<div class="testimonial__grid testimonial__grid--{{ fields.columns|default(3) }}cols">
					{% for testimonial in fields.testimonials %}
						<div class="testimonial__item">
							<div class="testimonial__card">
								<blockquote class="testimonial__quote">
									{{ testimonial.post_excerpt|wp_strip_all_tags|truncate(180) }}
								</blockquote>

								{% if fields.show_rating %}
								<div class="testimonial__rating" aria-label="Rating: 5 out of 5 stars">
									<span class="testimonial__stars" aria-hidden="true">★★★★★</span>
									</div>
								{% endif %}

								{% if fields.show_author %}
									<div class="testimonial__author">
										{% if fields.show_image and testimonial.thumbnail %}
											<div class="testimonial__image testimonial__image--grid">
												{{ testimonial.thumbnail }}
											</div>
										{% endif %}
										<div class="testimonial__author-info">
											<p class="testimonial__author-name">{{ testimonial.post_title }}</p>
										</div>
									</div>
								{% endif %}
							</div>
						</div>
					{% endfor %}
				</div>
			{% endif %}
		{% endif %}
	</div>
</section>
