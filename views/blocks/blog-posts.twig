{#
Title: Blog Posts
Description: Display recent blog posts in a grid layout with links
Category: common
Icon: <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="#fff" stroke="#000" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="feather feather-bookmark"><path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"></path></svg>
Keywords: blog posts grid layout
Mode: auto
PostTypes: page
SupportsMode: true
SupportsMultiple: true
#}

{% set title = fields.title | default('') %}
{% set selected_posts = fields.blog_posts | default([]) %}
{% set show_excerpt = fields.show_excerpt | default(true) %}
{% set show_date = fields.show_date | default(true) %}

<section class="blog-posts-block {{block.classes}}">
    <div class="wrapper">
        {% if title %}
            <h2 class="blog-posts-block__title">{{ title }}</h2>
        {% endif %}

        <div class="blog-posts-block__grid">
            {% if selected_posts %}
                {% for item in selected_posts %}
                    {% set post = TimberPost(item.ID) %}
                    <article class="blog-posts-block__post">
                        {% if post.thumbnail %}
                            <div class="blog-posts-block__image">
                                <a href="{{ post.link }}" class="blog-posts-block__image-link">
                                    <img data-src="{{ post.thumbnail.src }}" alt="{{ post.title }}" loading="lazy" decoding="async">
                                </a>
                            </div>
                        {% endif %}

                        <div class="blog-posts-block__content">
                            <h3 class="blog-posts-block__post-title">
                                <a href="{{ post.link }}">{{ post.title }}</a>
                            </h3>

                            {% if show_date %}
                                <p class="blog-posts-block__post-date">
                                    <time datetime="{{ post.post_date }}">{{ post.post_date|date("F j, Y") }}</time>
                                </p>
                            {% endif %}

                            {% if show_excerpt and post.excerpt %}
                                <p class="blog-posts-block__post-excerpt">{{ post.excerpt }}</p>
                            {% endif %}

                            <a href="{{ post.link }}" class="btn btn--primary btn--sm">
                                {{ _e("Read More") }}
                            </a>
                        </div>
                    </article>
                {% endfor %}
            {% else %}
                <p class="blog-posts-block__no-posts">{{ _e("No blog posts found.") }}</p>
            {% endif %}
        </div>

        {# View All Posts Button #}
        <div class="blog-posts-block__footer">
            <a href="{{ site.link }}/blog" class="btn btn--secondary btn--lg">
                {{ _e("View All Blog Posts") }}
            </a>
        </div>
    </div>
</section>
