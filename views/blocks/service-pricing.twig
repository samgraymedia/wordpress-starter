{#
Title: Service Pricing
Description: Display services in pricing card layout with features and CTA
Category: common
Icon: dashicons-money-alt
Keywords: services pricing cards tiers
Mode: edit
SupportsMode: false
SupportsMultiple: true
#}

<div class="block-service-pricing">
	{% set services = block.data.services %}
	{% set columns = block.data.columns|default('3') %}
	{% set highlight = block.data.highlight %}
	{% set featured_service = block.data.featured_service %}
	{% set currency = block.data.currency|default('$') %}
	{% set show_duration = block.data.show_duration %}
	{% set show_features = block.data.show_features %}

	{% if services %}
		<div class="pricing-grid columns-{{ columns }}">
			{% for service in services %}
				{% set is_featured = highlight and featured_service and featured_service.id == service.id %}
				<div class="pricing-card {% if is_featured %}is-featured{% endif %}">
					{% if is_featured %}
						<div class="featured-badge">Recommended</div>
					{% endif %}

					{# Price #}
					{% set price = service.get_field('service_price') %}
					<div class="pricing-card__header">
						<h3 class="pricing-card__title">{{ service.title }}</h3>
						{% if price %}
							<div class="pricing-card__price">
								<span class="currency">{{ currency }}</span>
								<span class="amount">{{ price|number_format(0) }}</span>
								<span class="period">.{{ (price * 100) % 100 }}</span>
							</div>
						{% else %}
							<div class="pricing-card__price">
								<span class="amount">Custom</span>
							</div>
						{% endif %}
					</div>

					{# Duration #}
					{% if show_duration %}
						{% set duration = service.get_field('service_duration') %}
						{% if duration %}
							<div class="pricing-card__duration">
								<small>Duration: {{ duration }}</small>
							</div>
						{% endif %}
					{% endif %}

					{# Description #}
					<p class="pricing-card__description">{{ service.excerpt }}</p>

					{# Features #}
					{% if show_features %}
						{% set features = service.get_field('service_features') %}
						{% if features %}
							<ul class="pricing-card__features">
								{% for feature in features %}
									<li class="feature-item">
										<span class="feature-icon">✓</span>
										<span class="feature-text">{{ feature.feature_title }}</span>
									</li>
								{% endfor %}
							</ul>
						{% endif %}
					{% endif %}

					{# CTA Button #}
					{% set cta_text = service.get_field('service_cta_text')|default('Get Started') %}
					{% set cta_link = service.get_field('service_cta_link')|default(service.link) %}
					<div class="pricing-card__cta">
						<a href="{{ cta_link }}" class="btn btn-primary btn-lg btn-block">{{ cta_text }}</a>
					</div>

					{# Service Link #}
					<a href="{{ service.link }}" class="pricing-card__link">View Details →</a>
				</div>
			{% endfor %}
		</div>
	{% else %}
		<p class="notice">Please select services to display.</p>
	{% endif %}
</div>
