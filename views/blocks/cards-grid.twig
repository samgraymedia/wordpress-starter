{#
Title: Cards Grid
Description: Generic reusable card grid for services, features, team, categories, and any repeatable content
Category: common
Icon: <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#000" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7"></rect><rect x="14" y="3" width="7" height="7"></rect><rect x="14" y="14" width="7" height="7"></rect><rect x="3" y="14" width="7" height="7"></rect></svg>
Keywords: Cards Grid Services Features Categories Team
Mode: auto
Align: wide
PostTypes: page post
SupportsAlign: wide full
SupportsMode: true
SupportsMultiple: true
#}

<section id="cards-{{ block.id }}" class="cards-grid {{ block.classes }} cards-grid--{{ fields.style|default('standard') }}">
	<div class="wrapper">
		{% if fields.title %}
			<div class="cards-grid__header">
				<h2 class="cards-grid__title">{{ fields.title }}</h2>
				{% if fields.description %}
					<p class="cards-grid__description">{{ fields.description }}</p>
				{% endif %}
			</div>
		{% endif %}

		{% if fields.cards %}
			<div class="cards-grid__grid cards-grid__grid--{{ fields.columns|default(3) }}cols" style="--image-height: {{ fields.image_height|default('250px') }}">
				{% for card in fields.cards %}
					<div class="cards-grid__item{% if card.highlight %} cards-grid__item--highlight{% endif %}">
						{% if fields.style == 'overlay' %}
							{# Overlay Style #}
							<div class="cards-grid__card cards-grid__card--overlay">
								<div class="cards-grid__image">
									<img src="{{ card.image.url }}" alt="{{ card.image_alt }}" loading="lazy" decoding="async" />
								</div>
								<div class="cards-grid__overlay">
									<div class="cards-grid__content">
										<h3 class="cards-grid__title-inner">{{ card.title }}</h3>
										<p class="cards-grid__description-inner">{{ card.description }}</p>
										{% if card.link %}
											<a href="{{ card.link.url }}" class="cards-grid__link" target="{{ card.link.target|default('_self') }}">
												{{ card.link.title|default('Learn More') }} <i class="fa-solid fa-arrow-right"></i>
											</a>
										{% endif %}
									</div>
								</div>
							</div>

						{% elseif fields.style == 'horizontal' %}
							{# Horizontal Style #}
							<div class="cards-grid__card cards-grid__card--horizontal">
								<div class="cards-grid__image">
									<img src="{{ card.image.url }}" alt="{{ card.image_alt }}" loading="lazy" decoding="async" />
								</div>
								<div class="cards-grid__content">
									<h3 class="cards-grid__title-inner">{{ card.title }}</h3>
									<p class="cards-grid__description-inner">{{ card.description }}</p>
									{% if card.link %}
										<a href="{{ card.link.url }}" class="cards-grid__link" target="{{ card.link.target|default('_self') }}">
											{{ card.link.title|default('Learn More') }} <i class="fa-solid fa-arrow-right"></i>
										</a>
									{% endif %}
								</div>
							</div>

						{% else %}
							{# Standard Style #}
							<div class="cards-grid__card cards-grid__card--standard">
								<div class="cards-grid__image">
									<img src="{{ card.image.url }}" alt="{{ card.image_alt }}" loading="lazy" decoding="async" />
								</div>
								<div class="cards-grid__content">
									<h3 class="cards-grid__title-inner">{{ card.title }}</h3>
									<p class="cards-grid__description-inner">{{ card.description }}</p>
									{% if card.link %}
										<a href="{{ card.link.url }}" class="cards-grid__link" target="{{ card.link.target|default('_self') }}">
											{{ card.link.title|default('Learn More') }} <i class="fa-solid fa-arrow-right"></i>
										</a>
									{% endif %}
								</div>
							</div>
						{% endif %}
					</div>
				{% endfor %}
			</div>
		{% endif %}
	</div>
</section>
