{#
Title: Image + Text
Description: A block with image on one side and content (titles and text) on the other, with flippable layout
Category: common
Icon: <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="#fff" stroke="#000" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="feather feather-columns"><path d="M12 3v18M3 3h6v18H3zM15 3h6v18h-6z"></path></svg>
Keywords: Image, Text, Content, Layout
Mode: auto
Align: wide
PostTypes: page post
SupportsAlign: wide full
SupportsMode: true
SupportsMultiple: true
#}
<section id="image-text-{{block.id}}" class="image-text {{block.classes}} image-text--{{fields.layout|default('left')}}">
	<div class="wrapper">
		<div class="image-text__image">
			{% if fields.image %}
				<img data-src="{{ fields.image.url }}" alt="{{ fields.image.alt }}" class="image-text__img" loading="lazy" decoding="async">
			{% endif %}
		</div>

		<div class="image-text__content">
			{% if fields.content_items %}
				<div class="image-text__items">
					{% for item in fields.content_items %}
						<div class="image-text__item">
							{% if item.title %}
								<h3 class="image-text__title">{{ item.title }}</h3>
							{% endif %}

							{% if item.subtext %}
								<p class="image-text__subtext">{{ item.subtext }}</p>
							{% endif %}
						</div>
					{% endfor %}
				</div>
			{% endif %}
		</div>
	</div>
</section>
