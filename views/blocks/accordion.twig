{#
Title: Accordion
Description: Expandable accordion section with multiple items
Category: common
Icon: <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="#fff" stroke="#000" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="feather feather-list"><line x1="8" y1="6" x2="21" y2="6"></line><line x1="8" y1="12" x2="21" y2="12"></line><line x1="8" y1="18" x2="21" y2="18"></line><line x1="3" y1="6" x2="3.01" y2="6"></line><line x1="3" y1="12" x2="3.01" y2="12"></line><line x1="3" y1="18" x2="3.01" y2="18"></line></svg>
Keywords: Accordion, Expandable, FAQ, Collapse
Mode: auto
Align: wide
PostTypes: page post
SupportsAlign: wide full
SupportsMode: true
SupportsMultiple: true
#}
<section class="accordion {{block.classes}}">
	<div class="wrapper">
		{% if fields.title %}
			<h2 class="accordion__section-title">{{ fields.title }}</h2>
		{% endif %}

		<div class="accordion__items" data-accordion-id="{{block.id}}">
			{% if fields.items %}
				{% for item in fields.items %}
					<div class="accordion__item" data-accordion-item="{{loop.index0}}">
						<button 
							class="accordion__trigger" 
							aria-expanded="false" 
							aria-controls="accordion-panel-{{block.id}}-{{loop.index0}}"
							type="button"
						>
							<span class="accordion__title">{{ item.title }}</span>
							<svg class="accordion__icon" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
								<polyline points="6 9 12 15 18 9"></polyline>
							</svg>
						</button>

						<div 
							class="accordion__panel" 
							id="accordion-panel-{{block.id}}-{{loop.index0}}"
							role="region"
							aria-labelledby="accordion-trigger-{{block.id}}-{{loop.index0}}"
							hidden
						>
							<div class="accordion__content">
								{{ item.content }}
							</div>
						</div>
					</div>
				{% endfor %}
			{% endif %}
		</div>
	</div>
</section>

{# FAQ Schema Markup - SEO Enhancement #}
{% if fields.items %}
<script type="application/ld+json">
{
	"@context": "https://schema.org",
	"@type": "FAQPage",
	"mainEntity": [
		{% for item in fields.items %}
		{
			"@type": "Question",
			"name": "{{ item.title|striptags }}",
			"acceptedAnswer": {
				"@type": "Answer",
				"text": "{{ item.content|striptags|slice(0, 360) }}"
			}
		}{{ not loop.last ? ',' : '' }}
		{% endfor %}
	]
}
</script>
{% endif %}
