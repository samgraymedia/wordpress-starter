{#
Title: Table
Description: Flexible data table for specs, pricing, opening hours, comparisons, and more
Category: common
Icon: editor-table
Keywords: table data specs pricing comparison
Mode: auto
PostTypes: page post
SupportsMode: true
SupportsMultiple: true
#}

{%- set title = fields.title | default('') -%}
{%- set caption = fields.caption | default('') -%}
{%- set striped = fields.striped | default(false) -%}
{%- set rows = fields.rows | default([]) -%}

<div class="wrapper {{ block.classes }}">
	{%- if title -%}
		<h3 class="table__title">{{ title }}</h3>
	{%- endif -%}

	{%- if caption -%}
		<p class="table__caption">{{ caption }}</p>
	{%- endif -%}

	<div class="table__container">
		<table class="table {%- if striped %} table--striped{% endif %}">
			{%- set header_row = [] -%}
			{%- for row in rows -%}
				{%- if row.is_header -%}
					{%- set header_row = row -%}
				{%- endif -%}
			{%- endfor -%}

			{%- if header_row.cells is defined and header_row.cells -%}
				<thead>
					<tr class="table__row table__row--header">
						{%- for cell in header_row.cells -%}
							<th class="table__cell table__cell--header" scope="col">
								{{ cell.content }}
							</th>
						{%- endfor -%}
					</tr>
				</thead>
			{%- endif -%}

			<tbody>
				{%- for row in rows -%}
					{%- if not row.is_header -%}
						<tr class="table__row">
							{%- for cell in row.cells -%}
								<td class="table__cell">
									{{ cell.content }}
								</td>
							{%- endfor -%}
						</tr>
					{%- endif -%}
				{%- endfor -%}
			</tbody>
		</table>
	</div>
</div></div>
