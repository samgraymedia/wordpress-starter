{#
Title: FAQ Search / Filtered
Description: Advanced accordion with search, category filtering, and SEO schema markup
Category: common
Icon: <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#000" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path><path d="M9 10h.01"></path><path d="M12 10h.01"></path><path d="M15 10h.01"></path></svg>
Keywords: FAQ Search Filter Questions Answers
Mode: auto
Align: wide
PostTypes: page post
SupportsAlign: wide full
SupportsMode: true
SupportsMultiple: true
#}

<section id="faq-{{ block.id }}" class="faq-search {{ block.classes }}">
	<div class="wrapper">
		{% if fields.title %}
			<div class="faq-search__header">
				<h2 class="faq-search__title">{{ fields.title }}</h2>
				{% if fields.description %}
					<p class="faq-search__description">{{ fields.description }}</p>
				{% endif %}
			</div>
		{% endif %}

		{% if fields.items %}
			{# Search & Filter Controls #}
			<div class="faq-search__controls">
				{% if fields.enable_search %}
					<div class="faq-search__search">
						<input 
							type="text" 
							class="faq-search__search-input" 
							placeholder="Search FAQs..." 
							aria-label="Search FAQs"
							data-faq-search="{{block.id}}"
						/>
						<i class="fa-solid fa-magnifying-glass"></i>
					</div>
				{% endif %}

				{% if fields.enable_categories and fields.categories %}
					{% set categories = fields.categories|split(',') %}
					<div class="faq-search__filter">
						<label for="faq-filter-{{block.id}}" class="faq-search__filter-label">Filter by Category:</label>
						<select id="faq-filter-{{block.id}}" class="faq-search__filter-select" data-faq-filter="{{block.id}}">
							<option value="">All Categories</option>
							{% for category in categories %}
								<option value="{{ category|trim|lower }}">{{ category|trim }}</option>
							{% endfor %}
						</select>
					</div>
				{% endif %}
			</div>

			{# FAQ Items #}
			<div class="faq-search__items" data-faq-id="{{block.id}}">
				{% for item in fields.items %}
					<div 
						class="faq-search__item" 
						data-faq-category="{{ item.category|lower }}"
						data-faq-question="{{ item.question|striptags|lower }}"
					>
						<button 
							class="faq-search__trigger{% if loop.first and fields.expand_first %} is-expanded{% endif %}" 
							aria-expanded="{% if loop.first and fields.expand_first %}true{% else %}false{% endif %}" 
							aria-controls="faq-panel-{{block.id}}-{{loop.index0}}"
							type="button"
						>
							<span class="faq-search__question">{{ item.question }}</span>
							<svg class="faq-search__icon" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
								<polyline points="6 9 12 15 18 9"></polyline>
							</svg>
						</button>

						<div 
							class="faq-search__panel" 
							id="faq-panel-{{block.id}}-{{loop.index0}}"
							role="region"
							{% if not (loop.first and fields.expand_first) %}hidden{% endif %}
						>
							<div class="faq-search__answer">
								{{ item.answer|raw }}
							</div>
						</div>
					</div>
				{% endfor %}
			</div>

			{# No Results Message #}
			<div class="faq-search__no-results" style="display:none;">
				<p>No FAQs match your search or filter. Please try different keywords or categories.</p>
			</div>
		{% endif %}
	</div>
</section>

{# FAQ Search/Filter Script #}
<script>
(function() {
	const blockId = '{{ block.id }}';
	const faqContainer = document.querySelector('[data-faq-id="' + blockId + '"]');
	const searchInput = document.querySelector('[data-faq-search="' + blockId + '"]');
	const filterSelect = document.querySelector('[data-faq-filter="' + blockId + '"]');
	const noResults = document.querySelector('.faq-search__no-results');
	const items = faqContainer ? faqContainer.querySelectorAll('.faq-search__item') : [];

	if (!faqContainer) return;

	// Accordion functionality
	faqContainer.addEventListener('click', function(e) {
		const trigger = e.target.closest('.faq-search__trigger');
		if (!trigger) return;

		const item = trigger.closest('.faq-search__item');
		const panel = item.querySelector('.faq-search__panel');
		const isExpanded = trigger.getAttribute('aria-expanded') === 'true';

		trigger.setAttribute('aria-expanded', !isExpanded);
		trigger.classList.toggle('is-expanded');
		panel.hidden = isExpanded;
	});

	// Search functionality
	if (searchInput) {
		searchInput.addEventListener('input', filterFAQs);
	}

	// Filter functionality
	if (filterSelect) {
		filterSelect.addEventListener('change', filterFAQs);
	}

	function filterFAQs() {
		const searchTerm = searchInput ? searchInput.value.toLowerCase() : '';
		const selectedCategory = filterSelect ? filterSelect.value.toLowerCase() : '';
		let visibleCount = 0;

		items.forEach(item => {
			const question = item.getAttribute('data-faq-question');
			const category = item.getAttribute('data-faq-category');

			const matchesSearch = !searchTerm || question.includes(searchTerm);
			const matchesCategory = !selectedCategory || category === selectedCategory;
			const isVisible = matchesSearch && matchesCategory;

			item.style.display = isVisible ? '' : 'none';
			if (isVisible) visibleCount++;
		});

		// Show/hide no results message
		if (noResults) {
			noResults.style.display = visibleCount === 0 ? '' : 'none';
		}
	}
})();
</script>

{# FAQ Schema Markup - SEO Enhancement #}
{% if fields.schema_enabled and fields.items %}
<script type="application/ld+json">
{
	"@context": "https://schema.org",
	"@type": "FAQPage",
	"mainEntity": [
		{% for item in fields.items %}
		{
			"@type": "Question",
			"name": "{{ item.question|striptags }}",
			"acceptedAnswer": {
				"@type": "Answer",
				"text": "{{ item.answer|striptags|slice(0, 360) }}"
			}
		}{{ not loop.last ? ',' : '' }}
		{% endfor %}
	]
}
</script>
{% endif %}
