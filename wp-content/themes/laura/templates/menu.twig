{% if menu %}
	<ul class="{{ mobile ? 'mobile-menu' : '' }}">
	{% for item in items %}
		<li class="{{ item.classes | join(' ') }}{{ mobile ? ' mobile-menu__item' : '' }}">
			<a target="{{ item.target }}" href="{{ item.link }}" class="{{ mobile ? 'mobile-menu__link' : '' }}">{{ item.title }}</a>
			{% if item.children %}
				{% include "menu.twig" with {'items': item.children, 'mobile': mobile} %}
			{% endif %}
		</li>
	{% endfor %}
	</ul>
{% endif %}
