{% extends "base.twig" %}

{% block content %}
<div id="page-header" class="page-header no-background" role="region" aria-label="Banner">
  <div class="wrapper">
    <div class="page-header-content">
      <h1>Security Insights Blog</h1>
      <p>Professional insights, best practices, and industry updates from the world of event security</p>
    </div>
  </div>
</div>
<div class="blog-page-content">
<div class="wrapper">

	<div class="blog-posts">
	{% for post in posts %}
		{% include ['tease-'~post.post_type~'.twig', 'tease.twig'] %}
	{% endfor %}
	</div>
	{% include 'partial/pagination.twig' with { pagination: posts.pagination({show_all: false, mid_size: 3, end_size: 2}) } %}
</div>    
</div>
{% endblock %}
