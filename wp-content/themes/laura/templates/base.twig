{% block html_head_container %}
{% include 'html-header.twig' %}
	{% block head %}
	{% endblock %}
	</head>
{% endblock %}

<body class="{{body_class}}" data-template="base.twig">
	<a class="skip-link screen-reader-text" href="#content">{{ _e( 'Skip to content') }}</a>
	<header class="header">
		{% block header %}
			<div class="wrapper">
				<nav id="nav-main" class="nav-main" role="navigation">
					<h1 class="hdr-logo" role="banner">
						<a class="hdr-logo-link" href="{{site.url}}" rel="home">{{site.name}}</a>
					</h1>
					<div class="nav-main__inner">
						{% include "menu.twig" with {'items': menu.get_items} %}
						<a href="{{site.url}}/contact#contact-form" class="btn btn-primary">Get Quote</a>
					</div>
					
					<!-- Mobile Navigation Toggle -->
					<button class="mobile-nav-toggle" aria-controls="mobile-nav" aria-expanded="false" aria-label="Toggle mobile navigation">
						<span class="hamburger">
							<span class="hamburger-line"></span>
							<span class="hamburger-line"></span>
							<span class="hamburger-line"></span>
						</span>
					</button>
				</nav>
				
				<!-- Mobile Navigation Menu -->
				<div id="mobile-nav" class="mobile-nav" aria-hidden="true">
					<div class="mobile-nav__container">
						<div class="mobile-nav__header">
							<h2 class="mobile-nav__title">{{site.name}}</h2>
						
						
						</div>
						<div class="mobile-nav__content">
							{% if menu and menu.get_items %}
								{% include "menu.twig" with {'items': menu.get_items, 'mobile': true} %}
							{% else %}
								<div class="mobile-menu">
									<div class="mobile-menu__item">
										<a href="{{site.url}}" class="mobile-menu__link">Home</a>
									</div>
									<div class="mobile-menu__item">
										<a href="{{site.url}}/about" class="mobile-menu__link">About</a>
									</div>
									<div class="mobile-menu__item">
										<a href="{{site.url}}/services" class="mobile-menu__link">Services</a>
									</div>
									<div class="mobile-menu__item">
										<a href="{{site.url}}/contact" class="mobile-menu__link">Contact</a>
									</div>
								</div>
							{% endif %}
							<div class="mobile-nav__cta">
								<a href="{{site.url}}/contact#contact-form" class="btn btn-primary btn-full">Get Quote</a>
							</div>
						</div>
					</div>
				</div>
			</div>
		{% endblock %}
	</header>

	<main id="content" role="main">
		{% block content %}
			Sorry, no content
		{% endblock %}

		{% if sidebar %}
			<aside class="layout-sidebar">
				{{sidebar}}
			</aside>
		{% endif %}
	</main>

	{% block footer %}
		<footer id="footer">
			{% include 'footer.twig' %}
		</footer>
		{{ function('wp_footer') }}
	{% endblock %}
</body>
</html>
