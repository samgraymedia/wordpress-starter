{% extends "base.twig" %}

{% block content %}
{{ post.content }}
<div class="content-wrapper">   
    <article class="post-type-page" id="post-{{ post.ID }}">
       
            {% set services = function('Timber::get_posts', {
                'post_type': 'service',
                'posts_per_page': -1,
                'orderby': 'menu_order date',
                'order': 'DESC'
            }) %}
            {% if services %}
                <div class="services-grid">
                <div class="wrapper">
                    {% for service in services %}
                        <div class="service-card">
                            <h5>{{ service.title }}</h5>
                            {% if service.meta('description') %}
                                <p>{{ service.meta('description') }}</p>
                            {% endif %}
                            {% if service.meta('features') %}
                                <ul>
                                    {% for feature in service.meta('features') %}
                                        <li>{{ feature.item }}</li>
                                    {% endfor %}
                                </ul>
                            {% endif %}

                        </div>
                    {% endfor %}    
                </div>
                </div>
            {% endif %}
      
   
            </div>          
    </article>
</div>
{% endblock %}  