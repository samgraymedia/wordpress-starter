<div class="cookie-consent">
    <div class="cookie-consent__container">
        <p class="cookie-consent__text">
            We use cookies to enhance your experience. By continuing to visit this site you agree to our use of cookies.
            {% if privacy_policy_url %}
                <a href="{{ privacy_policy_url }}" target="_blank" rel="noopener noreferrer">Learn more</a>
            {% endif %}
        </p>
        <div class="cookie-consent__buttons">
            <button class="btn btn-primary cookie-consent__button--accept">Accept</button>
            <button class="btn btn-secondary cookie-consent__button--decline">Decline</button>
        </div>
    </div>
</div> 