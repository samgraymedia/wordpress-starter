{% extends "base.twig" %}

{% block content %}
{# <div id="page-header" class="page-header no-background" role="region" aria-label="Banner">
  <div class="wrapper">
    <div class="page-header-content">
      <h1>Past Events</h1>
      <p>A showcase of events where I've successfully provided security services across Wales and the UK</p>
    </div>
  </div>
</div> #}
<div class="content-wrapper">
    <article class="post-type-page" id="post-{{ post.ID }}">
    {{ post.content }}
        <div class="wrapper">
            

            

            {% set events = function('Timber::get_posts', {
                'post_type': 'event',
               'posts_per_page': -1,
                'orderby': 'menu_order date',
                'order': 'DESC'
            }) %}

            <div class="events-grid" role="region" aria-label="Past Events">
                {% if events %}
                    {% for event in events %}
                        <div class="event-card" role="article">
                            {% if event.thumbnail %}
                                <div class="event-image">
                                    <img src="{{ event.thumbnail.src }}" alt="{{ event.thumbnail.alt|default(event.title ~ ' featured image') }}">
                                </div>
                            {% endif %}
                            <div class="event-content">
                                <header>
                                {% if event.meta('event_year') %}
                                        <time datetime="{{ event.meta('event_year')|date('Y-m-d') }}" class="event-date">
                                            {{ event.meta('event_year') }}
                                        </time>
                                    {% endif %}
                                    <h4>{{ event.title }}</h4>
                                    
                                    {% if event.meta('location') %}
                                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#007bff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-map-pin h-4 w-4 mr-2" data-lov-id="src/pages/Experience.tsx:163:26" data-lov-name="MapPin" data-component-path="src/pages/Experience.tsx" data-component-line="163" data-component-file="Experience.tsx" data-component-name="MapPin" data-component-content="%7B%22className%22%3A%22h-4%20w-4%20mr-2%22%7D"><path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0"></path><circle cx="12" cy="10" r="3"></circle></svg>
                                        <span class="event-venue">{{ event.meta('location') }}</span>
                                    {% endif %}
                                       {% if event.meta('attendees') %}
                                    <div class="event-attendance">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#007bff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-users h-4 w-4 mr-2" data-lov-id="src/pages/Experience.tsx:167:26" data-lov-name="Users" data-component-path="src/pages/Experience.tsx" data-component-line="167" data-component-file="Experience.tsx" data-component-name="Users" data-component-content="%7B%22className%22%3A%22h-4%20w-4%20mr-2%22%7D"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M22 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
                                        <span class="label">Attendance:</span>
                                        <span class="value">{{ event.meta('attendees') }}</span>
                                    </div>
                                {% endif %}
                                </header>

                                {% if event.meta('event_type') %}
                                    <div class="event-type">
                                        <span class="label">Event Type:</span>
                                        <span class="value">{{ event.meta('event_type') }}</span>
                                    </div>
                                {% endif %}

                             

                                {% if event.meta('small_des') %}
                                    <div class="event-description">
                                       {{ event.meta('small_des') }}
                                    </div>
                                {% endif %}

                                {% if event.meta('services_provided') %}
                                    <div class="services-provided">
                                        <span class="label">Services Provided:</span>
                                        <span class="value">{{ event.meta('services_provided') }}</span>
                                    </div>
                                {% endif %}

                                
                            </div>
                        </div>
                    {% endfor %}
                {% else %}
                    <p class="no-events">No past events to display at this time.</p>
                {% endif %}
            </div>
        </div>
    </article>
</div>
{% endblock %} 