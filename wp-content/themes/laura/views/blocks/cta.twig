{#
Title: Call to Action
Description: A compelling call-to-action block with customizable heading, text, and button
Category: formatting
Icon: <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="#fff" stroke="#000" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="feather feather-flag"><path d="M4 15s1-1 4-1 5 2 8 2 4-1 4-1V3s-1 1-4 1-5-2-8-2-4 1-4 1z"></path><line x1="4" y1="22" x2="4" y2="15"></line></svg>
Keywords: cta, call to action, button, conversion, action
Mode: preview
Align: full
PostTypes: page post
SupportsAlign: left right center wide full
SupportsMode: true
SupportsMultiple: true
#}

<div id="cta-{{block.id}}" class="cta block {{block.classes}}" role="region" aria-label="{{fields.title|default('Call to Action')}}">
  <div class="wrapper">
    <div class="cta-content">
      <h2>{{fields.title|default('Call to Action')}}</h2>
      <p>{{fields.intro|default('Content coming soon')}}</p>
      <a href="{{fields.button_link|default('#')}}" class="btn btn-primary">{{fields.button_text|default('Button Text')}}</a>
    </div>
  </div>
</div>