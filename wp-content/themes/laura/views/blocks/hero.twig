{#
Title: Hero Banner
Description: A customizable hero banner section with background image, heading, and call-to-action options
Category: formatting
Icon: <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="#fff" stroke="#000" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="feather feather-calendar"><rect x="3" y="4" width="18" height="18" rx="2" ry="2" fill="#fff"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
Keywords: hero banner, header, landing, featured section, call to action
Mode: preview
Align: full
PostTypes: page post
SupportsAlign: left right center wide full
SupportsMode: true
SupportsMultiple: false
#}

<div id="hero-{{block.id}}" class="hero block   {{block.classes}}">
<div class="hero-bg" style="background-image: url({{fields.background.url}});">
    
        <div class="hero-content">
            <h1>{{fields.main_title}}</h1>
            <h3>{{fields.sub_title}}</h3>
            <p>{{fields.text}}</p>
            <div class="hero-cta">
                <a href="{{fields.primary_button_link}}" class="btn btn-primary">{{fields.primary_button_text}}</a>
                 <a href="{{fields.secondary_button_link}}" class="btn btn-secondary">{{fields.secondary_button_text}}</a>
            </div>
          
        </div>
    
</div>
</div>