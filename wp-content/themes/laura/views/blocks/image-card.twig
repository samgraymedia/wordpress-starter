{#
Title: Image Card
Description: A versatile image card block for displaying images with optional text overlay and customizable styling
Category: formatting
Icon: <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="#fff" stroke="#000" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="feather feather-image"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><polyline points="21 15 16 10 5 21"></polyline></svg>
Keywords: image, card, media, photo, picture, gallery, visual
Mode: preview
Align: full
PostTypes: page post
SupportsAlign: left right center wide full
SupportsMode: true
SupportsMultiple: true
#}

<div class="image-cards block {{ block.classes }}">
    <div class="wrapper">
<h2>{{fields.title|default('Content Grid')}}</h2>
      <p>{{fields.lead|default('Content coming soon')}}</p>
    </div>
    {% if fields.cards %}
    <div class="wrapper">
        <div class="image-cards__grid">
            {% for card in fields.cards %}
                <div class="image-card">
                    {% if card.image %}
                        <div class="image-card__image-wrapper">
                            <img 
                                src="{{ Image(card.image).src }}" 
                                alt="{{ Image(card.image).alt }}"
                                class="image-card__image"
                                {% if Image(card.image).srcset %}
                                    srcset="{{ Image(card.image).srcset }}"
                                {% endif %}
                                loading="lazy"
                            >
                        </div>
                    {% endif %}
                    
                    {% if card.title or card.lead %}
                        <div class="image-card__content">
                            {% if card.title %}
                                <h3 class="image-card__title">{{ card.title }}</h3>
                            {% endif %}
                            
                            {% if card.lead %}
                                <div class="image-card__lead">{{ card.lead }}</div>
                            {% endif %}
                        </div   >
                    {% endif %}
                </div>
                {% endfor %}
            </div>
        </div>
    {% endif %}
</div>