{#
Title: Information Block
Description: A versatile information block with two variants - one for detailed personal/business information and another for service listings. Features customizable headings, text content, images, and call-to-action options.
Category: formatting
Icon: <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path><circle cx="12" cy="10" r="1"></circle><circle cx="8" cy="10" r="1"></circle><circle cx="16" cy="10" r="1"></circle></svg>
Keywords: information, about, services, description, business info, personal info, company profile
Mode: preview
Align: full
PostTypes: page post
SupportsAlign: left right center wide full
SupportsMode: true
SupportsMultiple: true
VariantType: select
Variants: detailed_info, service_list
#}
{% if fields.variant_one %}
<div id="information-{{block.id}}" class="information block information-one {{block.classes}}" role="region" aria-label="{{fields.variant_one.header|default('Information Section')}}">
  <div class="wrapper">
    <div class="information-content">
      <div class="information-left">
        <h2>{{fields.variant_one.header|default('Information')}}</h2>
        <p>{{fields.variant_one.content|default('Content coming soon')}}</p>
      </div>
      <div class="information-right">
        {% if fields.variant_one.image %}
          <img 
            src="{{fields.variant_one.image.url}}" 
            alt="{{fields.variant_one.image.alt|default(fields.variant_one.header)}}"
            loading="lazy"
          />
        {% endif %}
      </div>
    </div>
  </div>
</div>
{% endif %}

{% if fields.variant_two %}
<div id="information-{{block.id}}" class="information block information-two {{block.classes}}" role="region" aria-label="{{fields.variant_two.header|default('Services Information')}}">
  <div class="wrapper">
    <div class="information-content">
      <div class="information-left">
        <h2>{{fields.variant_two.header|default('Our Services')}}</h2>
        <p>{{fields.variant_two.intro|default('Discover our range of services')}}</p>
        {% if fields.variant_two.list %}
          <ul role="list">
            {% for item in fields.variant_two.list %}
              <li>{{item.item|default('')}}</li>
            {% endfor %}
          </ul>
        {% endif %}
        {% if fields.variant_two.button_text %}
          <a 
            href="{{fields.variant_two.button_link}}" 
            class="btn btn-primary"
            role="button"
            aria-label="{{fields.variant_two.button_text}}"
          >
            {{fields.variant_two.button_text}}
          </a>
        {% endif %}
      </div>
      <div class="information-right">
        {% if fields.variant_two.image %}
          <img 
            src="{{fields.variant_two.image.url}}" 
            alt="{{fields.variant_two.image.alt|default(fields.variant_two.header)}}"
            loading="lazy"
          />
        {% endif %}
      </div>
    </div>
  </div>
</div>
{% endif %}