{#
Title: Banner Block
Description: A versatile banner/call-to-action block with customizable heading, text, button, and optional background image
Category: formatting
Icon: <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="#fff" stroke="#000" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="feather feather-flag"><path d="M4 15s1-1 4-1 5 2 8 2 4-1 4-1V3s-1 1-4 1-5-2-8-2-4 1-4 1z"></path><line x1="4" y1="22" x2="4" y2="15"></line></svg>
Keywords: banner, cta, call to action, hero, background image, button, conversion, action
Mode: preview
Align: full
PostTypes: page post
SupportsAlign: left right center wide full
SupportsMode: true
SupportsMultiple: true
SupportsInnerBlocks: true

#}

<div id="page-header-{{block.id}}" class="page-header block {{block.classes}} {% if fields.background %}has-background {% else %}no-background{% endif %}" role="region" aria-label="{{fields.title|default('Banner')}}" {% if fields.background %}style="background-image: url({{fields.background.url}});"{% endif %}>
  <div class="wrapper">
    <div class="page-header-content">
      <h1>{{fields.title|default('Banner')}}</h1>
      <p>{{fields.intro|default('Content coming soon')}}</p>
    </div>
  </div>
</div>