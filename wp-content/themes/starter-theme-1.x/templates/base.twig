{% block html_head_container %}

	{% include 'html-header.twig' %}
	{% block head %}{% endblock %}
</head>{% endblock %}<body class="{{body_class}}" data-template="base.twig">
<a class="skip-link screen-reader-text" href="#content">{{ _e('Skip to content') }}</a>
<header class="header" role="banner">
	{% block header %}
		<div class="wrapper">
			<nav id="nav-main" class="nav-main" aria-label="{{ _e('Main Navigation') }}">
				{% include "menu.twig" with {'items': menu.get_items} %}
			</nav>
			{% if function('class_exists', 'WooCommerce') %}
				<div class="header__utilities">
					<div class="header__search">
						{% include "components/search-form.twig" %}
					</div>
					<div class="header__account">
						{% include "components/user-account.twig" %}
					</div>
				</div>
			{% endif %}
		</div>
	{% endblock %}
</header>

<main id="content" class="content-wrapper">

	<div class="{{sidebar_class}}">
		{% block content %}
			Sorry, no content
		{% endblock %}
	</div>
	{% if sidebar %}
		<aside class="layout-sidebar">
			{{sidebar}}
		</aside>
	{% endif %}
</main>

{% block footer %}
	<footer id="footer" role="contentinfo">
		{% include 'footer.twig' %}
	</footer>
	{{ function('wp_footer') }}
{% endblock %}</body></html>
