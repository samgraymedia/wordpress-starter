<div class="wrapper">
	<div
		class="footer__content">
		{# About Section #}
		<div class="footer__section">
			<h4 class="footer__title">{{ _e('About', 'starter-theme-1.x') }}</h4>
			<p class="footer__text">&copy;
				{{ "now"|date("Y") }}
				{{ site.name }}.
				{{ _e('All rights reserved.', 'starter-theme-1.x') }}</p>
			<p class="footer__text">{{ _e('High-quality products delivered to your doorstep.', 'starter-theme-1.x') }}</p>
		</div>

		{# Footer Navigation #}
		{% if menu %}
			<div class="footer__section">
				<h4 class="footer__title">{{ _e('Browse', 'starter-theme-1.x') }}</h4>
				<nav aria-label="{{ _e('Footer Navigation', 'starter-theme-1.x') }}">
					{% include "menu.twig" with {'items': menu.get_items} %}
				</nav>
			</div>
		{% endif %}

		{# Customer Support #}
		<div class="footer__section">
			<h4 class="footer__title">{{ _e('Support', 'starter-theme-1.x') }}</h4>
			<ul class="footer__list">
				<li class="footer__item">
					<a href="#" class="footer__link">{{ _e('Contact Us', 'starter-theme-1.x') }}</a>
				</li>
				<li class="footer__item">
					<a href="#" class="footer__link">{{ _e('Shipping Info', 'starter-theme-1.x') }}</a>
				</li>
				<li class="footer__item">
					<a href="#" class="footer__link">{{ _e('Returns', 'starter-theme-1.x') }}</a>
				</li>
				<li class="footer__item">
					<a href="#" class="footer__link">{{ _e('FAQ', 'starter-theme-1.x') }}</a>
				</li>
			</ul>
		</div>

		{# Newsletter #}
		<div class="footer__section">
			<h4 class="footer__title">{{ _e('Newsletter', 'starter-theme-1.x') }}</h4>
			<p class="footer__text">{{ _e('Get exclusive deals and updates!', 'starter-theme-1.x') }}</p>
			<form class="footer__newsletter-form">
				<input type="email" class="footer__newsletter-input" placeholder="{{ _e('your@email.com', 'starter-theme-1.x') }}" required/>
				<button type="submit" class="footer__newsletter-submit">{{ _e('Subscribe', 'starter-theme-1.x') }}</button>
			</form>
		</div>
	</div>

	{# Footer Bottom #}
	<div class="footer__bottom">
		<p class="footer__copyright">{{ _e('Built with', 'starter-theme-1.x') }}
			❤️
			{{ _e('for amazing customers', 'starter-theme-1.x') }}</p>
		<ul class="footer__social">
			<li>
				<a href="#" class="footer__social-link" title="Facebook">f</a>
			</li>
			<li>
				<a href="#" class="footer__social-link" title="Twitter">𝕏</a>
			</li>
			<li>
				<a href="#" class="footer__social-link" title="Instagram">📷</a>
			</li>
			<li>
				<a href="#" class="footer__social-link" title="LinkedIn">in</a>
			</li>
		</ul>
	</div>
</div>
