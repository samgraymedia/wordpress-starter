{#
 Page Template
 
 This template renders standard pages (post type: page).
 Extends base.twig and displays page title and content.
 #}

{% extends "base.twig" %}

{% block content %}
	<div class="content-wrapper">
		<article class="post-type-{{ post.post_type }}" id="post-{{ post.ID }}">
			<section class="article-content">
				<h1>{{ post.title }}</h1>
				<div class="article-body">
					{{ post.content }}
				</div>
			</section>
		</article>
	</div>
{% endblock %}