{#
Title: Tabs
Description: Display content in organized tabs with click or keyboard navigation
Category: common
Icon: <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="#fff" stroke="#000" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="feather feather-list"><line x1="8" y1="6" x2="21" y2="6"></line><line x1="8" y1="12" x2="21" y2="12"></line><line x1="8" y1="18" x2="21" y2="18"></line><line x1="3" y1="6" x2="3.01" y2="6"></line><line x1="3" y1="12" x2="3.01" y2="12"></line><line x1="3" y1="18" x2="3.01" y2="18"></line></svg>
Keywords: tabs, accordion, navigation, content, toggle
Mode: auto
PostTypes: page post
SupportsMode: true
SupportsMultiple: true
#}

{% set tabs = fields.tabs | default([]) %}
{% set title = fields.title | default('') %}
{% set default_active_tab = fields.default_active_tab | default(1) %}

<section class="tabs-block {{block.classes}}">
    <div class="wrapper">
        {% if title %}
            <h2 class="tabs-block__title">{{ title }}</h2>
        {% endif %}

        <div class="tabs-block__wrapper">
            {# Tab Buttons #}
            <div class="tabs-block__buttons" role="tablist">
                {% for tab in tabs %}
                    {% set tab_index = loop.index %}
                    {% set is_active = (tab_index == default_active_tab) ? 'true' : 'false' %}
                    <button 
                        class="tabs-block__button{% if tab_index == default_active_tab %} is-active{% endif %}"
                        role="tab"
                        aria-selected="{{ is_active }}"
                        aria-controls="tab-panel-{{ loop.index0 }}"
                        id="tab-button-{{ loop.index0 }}"
                        tabindex="{% if tab_index == default_active_tab %}0{% else %}-1{% endif %}"
                        data-tab-index="{{ loop.index0 }}"
                    >
                        {{ tab.tab_title }}
                    </button>
                {% endfor %}
            </div>

            {# Tab Content Panels #}
            <div class="tabs-block__content">
                {% for tab in tabs %}
                    <div 
                        class="tabs-block__panel{% if loop.index == default_active_tab %} is-active{% endif %}"
                        role="tabpanel"
                        id="tab-panel-{{ loop.index0 }}"
                        aria-labelledby="tab-button-{{ loop.index0 }}"
                        {% if loop.index != default_active_tab %}hidden{% endif %}
                    >
                        {{ tab.tab_content | wpautop }}
                    </div>
                {% endfor %}
            </div>
        </div>
    </div>
</section>
