{#
Title: Announcement Bar
Description: Sticky announcement bar with message, optional button, and dismiss functionality
Category: common
Icon: <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="#fff" stroke="#000" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="feather feather-alert-circle"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
Keywords: Announcement, Banner, Alert, Notification, Dismiss
Mode: auto
PostTypes: page post
SupportsMode: true
SupportsMultiple: false
#}
<!-- Announcement Bar -->
<div 
	class="announcement {{block.classes}}" 
	data-announcement-id="announcement-{{block.id}}"
>
	<div class="announcement__inner">
		<div class="announcement__content">
			{% if fields.icon %}
				<svg class="announcement__icon" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
					{% if fields.icon == 'alert' %}
						<circle cx="12" cy="12" r="10"></circle>
						<line x1="12" y1="8" x2="12" y2="12"></line>
						<line x1="12" y1="16" x2="12.01" y2="16"></line>
					{% elseif fields.icon == 'info' %}
						<circle cx="12" cy="12" r="10"></circle>
						<line x1="12" y1="16" x2="12" y2="12"></line>
						<line x1="12" y1="8" x2="12.01" y2="8"></line>
					{% elseif fields.icon == 'check' %}
						<polyline points="20 6 9 17 4 12"></polyline>
					{% elseif fields.icon == 'star' %}
						<polygon points="12 2 15.09 10.26 23.83 10.5 17.77 16.31 20.16 25.09 12 20.16 3.84 25.09 6.23 16.31 0.17 10.5 8.91 10.26 12 2"></polygon>
					{% endif %}
				</svg>
			{% endif %}

			<div class="announcement__text">
				{{ fields.message }}
			</div>
		</div>

		{% if fields.button_text and fields.button_url %}
			<a href="{{fields.button_url}}" class="announcement__button">
				{{ fields.button_text }}
			</a>
		{% endif %}

		<button class="announcement__close" aria-label="Close announcement" type="button">
			<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
				<line x1="18" y1="6" x2="6" y2="18"></line>
				<line x1="6" y1="6" x2="18" y2="18"></line>
			</svg>
		</button>
	</div>
</div>
