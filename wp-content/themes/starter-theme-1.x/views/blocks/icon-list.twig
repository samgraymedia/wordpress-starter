{#
Title: Icon List / Features List
Description: Clean structured list with icons, labels, and descriptions. Perfect for benefits, features, or capability lists.
Category: common
Icon: <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#000" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="21" r="1"></circle><circle cx="20" cy="21" r="1"></circle><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path></svg>
Keywords: Icon List Features Benefits Checklist
Mode: auto
Align: wide full
PostTypes: page post
SupportsAlign: wide full
SupportsMode: true
SupportsMultiple: true
#}

<section id="icon-list-{{ block.id }}" class="icon-list {{ block.classes }} icon-list--{{ fields.layout|default('vertical') }} icon-list--align-{{ fields.text_align|default('left') }} icon-list--icon-{{ fields.icon_size|default('medium') }} icon-list--color-{{ fields.icon_color|default('primary') }}">
	<div class="wrapper">
		{% if fields.title %}
			<div class="icon-list__header">
				<h2 class="icon-list__title">{{ fields.title }}</h2>
				{% if fields.description %}
					<p class="icon-list__description">{{ fields.description }}</p>
				{% endif %}
			</div>
		{% endif %}

		{% if fields.items %}
			{% if fields.layout == 'horizontal' %}
				<div class="icon-list__container icon-list__container--horizontal">
					{% for item in fields.items %}
						<div class="icon-list__item">
							<div class="icon-list__icon-wrapper">
								{% if item.icon %}
									<div class="icon-list__icon">
										{% if '<svg' in item.icon %}
											{{ item.icon|raw }}
										{% else %}
											<i class="icon {{ item.icon }}"></i>
										{% endif %}
									</div>
								{% endif %}
							</div>
							<div class="icon-list__content">
								<h3 class="icon-list__label">{{ item.label }}</h3>
								{% if item.description %}
									<p class="icon-list__text">{{ item.description }}</p>
								{% endif %}
							</div>
						</div>
					{% endfor %}
				</div>

			{% elseif fields.layout == 'columns' %}
				<div class="icon-list__container icon-list__container--columns icon-list__container--{{ fields.columns|default(3) }}cols">
					{% for item in fields.items %}
						<div class="icon-list__item icon-list__item--column">
							{% if item.icon %}
								<div class="icon-list__icon-wrapper">
									<div class="icon-list__icon">
										{% if '<svg' in item.icon %}
											{{ item.icon|raw }}
										{% else %}
											<i class="icon {{ item.icon }}"></i>
										{% endif %}
									</div>
								</div>
							{% endif %}
							<div class="icon-list__content">
								<h3 class="icon-list__label">{{ item.label }}</h3>
								{% if item.description %}
									<p class="icon-list__text">{{ item.description }}</p>
								{% endif %}
							</div>
						</div>
					{% endfor %}
				</div>

			{% else %}
				<div class="icon-list__container icon-list__container--vertical">
					{% for item in fields.items %}
						<div class="icon-list__item icon-list__item--vertical">
							<div class="icon-list__item-inner">
								{% if item.icon %}
									<div class="icon-list__icon-wrapper">
										<div class="icon-list__icon">
											{% if '<svg' in item.icon %}
												{{ item.icon|raw }}
											{% else %}
												<i class="icon {{ item.icon }}"></i>
											{% endif %}
										</div>
									</div>
								{% endif %}
								<div class="icon-list__content">
									<h3 class="icon-list__label">{{ item.label }}</h3>
									{% if item.description %}
										<p class="icon-list__text">{{ item.description }}</p>
									{% endif %}
								</div>
							</div>
						</div>
					{% endfor %}
				</div>
			{% endif %}
		{% endif %}
	</div>
</section>
