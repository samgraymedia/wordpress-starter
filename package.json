{
  "name": "starter-theme",
  "version": "1.0.0",
  "description": "Starter Theme WordPress Theme",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "sass": "sass style.scss:style.css --style=compressed --no-source-map",
    "watch:css": "sass style.scss:style.css --watch --style=compressed --no-source-map",
    "watch": "concurrently \"npm:dev\" \"npm:watch:css\"",
    "lint": "eslint scripts/**/*.js",
    "lint:fix": "eslint scripts/**/*.js --fix",
    "a11y:audit": "node scripts/utils/a11y-audit.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:php": "phpunit",
    "test:php:coverage": "phpunit --coverage-html=coverage/html --coverage-clover=coverage/clover.xml"
  },
  "dependencies": {
    "bootstrap": "^5.3.0"
  },
  "devDependencies": {
    "@axe-core/cli": "^4.8.0",
    "@babel/core": "^7.23.0",
    "@babel/preset-env": "^7.23.0",
    "@testing-library/dom": "^9.3.0",
    "@testing-library/jest-dom": "^6.1.0",
    "axe-core": "^4.8.0",
    "babel-jest": "^29.7.0",
    "concurrently": "^8.2.0",
    "eslint": "^8.53.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "sass": "^1.69.0",
    "terser": "^5.25.0",
    "vite": "^5.0.0"
  }
}
