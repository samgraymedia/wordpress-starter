{#
    Twig Macros
    
    Common utility macros for repetitive template patterns
    
    Usage in templates:
    {% import "macros.twig" as macros %}
    {{ macros.badge('New', 'success') }}
#}

{#
    Badge Macro
    Renders a small badge/label
#}
{% macro badge(text, variant = 'default') %}
    <span class="badge badge--{{ variant }}">{{ text }}</span>
{% endmacro %}

{#
    Icon Macro
    Renders a dashicon
#}
{% macro icon(icon_name, classes = '') %}
    <span class="dashicons dashicons-{{ icon_name }} {{ classes }}"></span>
{% endmacro %}

{#
    Truncate Text Macro
    Truncate text with ellipsis
#}
{% macro truncate(text, length = 100) %}
    {% if text|length > length %}
        {{ text[:length] }}...
    {% else %}
        {{ text }}
    {% endif %}
{% endmacro %}

{#
    Price Macro
    Format and display price
#}
{% macro price(amount, currency = '$') %}
    <span class="price">{{ currency }}<span class="price__amount">{{ amount|number_format(2) }}</span></span>
{% endmacro %}

{#
    Star Rating Macro
    Display star rating
#}
{% macro rating(stars, max_stars = 5) %}
    <div class="rating" aria-label="Rating: {{ stars }} out of {{ max_stars }} stars">
        {% for i in range(1, max_stars) %}
            <span class="dashicons dashicons-star-{{ i <= stars ? 'filled' : 'empty' }}"></span>
        {% endfor %}
    </div>
{% endmacro %}

{#
    Meta List Macro
    Display post meta information as a list
#}
{% macro meta_list(items) %}
    <ul class="meta-list">
        {% for item in items %}
            <li class="meta-list__item">
                {% if item.icon %}
                    <span class="dashicons dashicons-{{ item.icon }}"></span>
                {% endif %}
                <span class="meta-list__text">{{ item.label }}</span>
                {% if item.value %}
                    <span class="meta-list__value">{{ item.value }}</span>
                {% endif %}
            </li>
        {% endfor %}
    </ul>
{% endmacro %}

{#
    Read Time Macro
    Estimate and display reading time
#}
{% macro read_time(content, words_per_minute = 200) %}
    {% set word_count = content|split|length %}
    {% set minutes = (word_count / words_per_minute)|round(0, 'ceil') %}
    <span class="read-time">
        {{ _e('Reading time') }}: {{ minutes }} {{ minutes == 1 ? 'minute' : 'minutes' }}
    </span>
{% endmacro %}

{#
    Social Links Macro
    Render social media links
#}
{% macro social_links(links) %}
    <ul class="social-links">
        {% for network, url in links %}
            <li class="social-links__item">
                <a href="{{ url }}" class="social-links__link" target="_blank" rel="noopener noreferrer" aria-label="{{ network }}">
                    <span class="dashicons dashicons-{{ network }}"></span>
                </a>
            </li>
        {% endfor %}
    </ul>
{% endmacro %}

{#
    Breadcrumb Macro
    Render breadcrumb navigation
#}
{% macro breadcrumbs(items) %}
    <nav class="breadcrumbs" aria-label="Breadcrumb">
        <ol class="breadcrumbs__list">
            {% for item in items %}
                <li class="breadcrumbs__item">
                    {% if item.url %}
                        <a href="{{ item.url }}" class="breadcrumbs__link">{{ item.label }}</a>
                    {% else %}
                        <span class="breadcrumbs__text">{{ item.label }}</span>
                    {% endif %}
                </li>
            {% endfor %}
        </ol>
    </nav>
{% endmacro %}
