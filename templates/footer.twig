<div class="footer-overlay"></div>
<div class="wrapper">
	<div class="footer-content">
		<div class="footer-left">
			<h3>&copy;
				{{ 'now'|date('Y') }}
				{{ site.name }}</h3>


			{% set facebook = function('get_field', 'facebook_url', 'option') %}
			{% set twitter = function('get_field', 'twitter_url', 'option') %}
			{% set instagram = function('get_field', 'instagram_url', 'option') %}
			{% set linkedin = function('get_field', 'linkedin_url', 'option') %}

			{% if facebook or twitter or instagram or linkedin %}
				<div class="footer-social">

					<ul>
						{% if facebook %}
							<li>
								<a href="{{ facebook }}" target="_blank" rel="noopener noreferrer">{{ _e('Facebook') }}</a>
							</li>
						{% endif %}
						{% if twitter %}
							<li>
								<a href="{{ twitter }}" target="_blank" rel="noopener noreferrer">{{ _e('Twitter') }}</a>
							</li>
						{% endif %}
						{% if instagram %}
							<li>
								<a href="{{ instagram }}" target="_blank" rel="noopener noreferrer">{{ _e('Instagram') }}</a>
							</li>
						{% endif %}
						{% if linkedin %}
							<li>
								<a href="{{ linkedin }}" target="_blank" rel="noopener noreferrer">{{ _e('LinkedIn') }}</a>
							</li>
						{% endif %}
					</ul>
				</div>
			{% endif %}

		</div>
		<nav aria-label="Footer Navigation">

			{% set footer_menu = function('wp_get_nav_menu_items', function('get_nav_menu_locations')['footer'] ?? 0) %}
			{% if footer_menu %}
				<ul>
					{% for item in footer_menu %}
						<li>
							<a href="{{ item.url }}">{{ item.title }}</a>
						</li>
					{% endfor %}
				</ul>
			{% endif %}
		</nav>


	</div>
</div>
<div class="watermark">
</div>
