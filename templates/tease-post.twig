{% extends "tease.twig" %}

{% block content %}
	<h2 class="h2"><a href="{{post.link}}">{{post.title}}</a></h2>
		<p>{{post.preview.length(25)}}</p>
		{% if post.thumbnail.src %}
			<img data-src="{{post.thumbnail.src}}" alt="{{ post.title }}" loading="lazy" decoding="async" />
		{% endif %}
{% endblock %}