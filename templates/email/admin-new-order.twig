{# Admin New Order Email
   
   Sent to admin when a new order is received.
   
   Variables:
   - order: WC_Order object
   - email_heading: Email heading text
   - additional_content: Custom admin notes
#}
{% extends "email/base.twig" %}

{% block email_content %}
	<h2>{{ email_heading | default('New Order Received') }}</h2>

	<p>
		A new order has been placed. Order details:
	</p>

	{# Order Summary Box #}
	<div class="alert alert-info">
		<p class="mb-1">
			<strong>Order #{{ order.get_order_number() }}</strong>
		</p>
		<p class="text-muted mb-0">
			{{ order.get_date_created().format('F j, Y @ g:i a') }}
		</p>
	</div>

	{# Customer Details #}
	<h3>Customer Details</h3>
	<table style="width: 100%; margin-bottom: 20px;">
		<tr>
			<td style="padding: 8px 0; border-bottom: 1px solid #dee2e6;">
				<strong>Name:</strong>
				{{ order.get_billing_first_name() }}
				{{ order.get_billing_last_name() }}
			</td>
		</tr>
		<tr>
			<td style="padding: 8px 0; border-bottom: 1px solid #dee2e6;">
				<strong>Email:</strong>
				<a href="mailto:{{ order.get_billing_email() }}">{{ order.get_billing_email() }}</a>
			</td>
		</tr>
		{% if order.get_billing_phone() %}
			<tr>
				<td style="padding: 8px 0; border-bottom: 1px solid #dee2e6;">
					<strong>Phone:</strong>
					{{ order.get_billing_phone() }}
				</td>
			</tr>
		{% endif %}
	</table>

	{# Order Items #}
	<h3>Order Items</h3>
	<table class="order-table">
		<thead>
			<tr>
				<th>Product</th>
				<th class="text-right">Qty</th>
				<th class="text-right">Price</th>
				<th class="text-right">Total</th>
			</tr>
		</thead>
		<tbody>
			{% for item in order.get_items() %}
				<tr>
					<td>
						<strong>{{ item.get_name() }}</strong>
						{% if item.get_product() %}
							<br><span class="text-muted" style="font-size: 12px;">SKU:
								{{ item.get_product().get_sku() }}</span>
						{% endif %}
					</td>
					<td class="text-right">{{ item.get_quantity() }}</td>
					<td class="text-right">{{ item.get_subtotal() | wc_price }}</td>
					<td class="text-right">
						<strong>{{ item.get_total() | wc_price }}</strong>
					</td>
				</tr>
			{% endfor %}
		</tbody>
	</table>

	{# Order Totals #}
	<table style="width: 100%; margin: 20px 0; border-top: 2px solid #dee2e6;">
		<tr>
			<td style="padding: 10px 0; text-align: right;">
				<strong>Subtotal:</strong>
			</td>
			<td style="padding: 10px 0; text-align: right; width: 120px;">
				{{ order.get_subtotal() | wc_price }}
			</td>
		</tr>
		{% set shipping = order.get_shipping_total() %}
		{% if shipping > 0 %}
			<tr>
				<td style="padding: 10px 0; text-align: right;">
					<strong>Shipping:</strong>
				</td>
				<td style="padding: 10px 0; text-align: right; width: 120px;">
					{{ shipping | wc_price }}
				</td>
			</tr>
		{% endif %}
		{% set tax = order.get_total_tax() %}
		{% if tax > 0 %}
			<tr>
				<td style="padding: 10px 0; text-align: right;">
					<strong>Tax:</strong>
				</td>
				<td style="padding: 10px 0; text-align: right; width: 120px;">
					{{ tax | wc_price }}
				</td>
			</tr>
		{% endif %}
		<tr style="border-top: 2px solid #dee2e6;">
			<td style="padding: 10px 0; text-align: right;">
				<strong style="font-size: 16px;">Total:</strong>
			</td>
			<td style="padding: 10px 0; text-align: right; width: 120px;">
				<strong style="font-size: 16px;">{{ order.get_total() | wc_price }}</strong>
			</td>
		</tr>
	</table>

	{# Billing Address #}
	<h3>Billing Address</h3>
	<div style="background-color: #f9fafb; padding: 15px; border-radius: 4px; margin-bottom: 20px;">
		{{ order.get_formatted_billing_address() | raw }}
	</div>

	{# Shipping Address #}
	{% if order.get_formatted_shipping_address() %}
		<h3>Shipping Address</h3>
		<div style="background-color: #f9fafb; padding: 15px; border-radius: 4px; margin-bottom: 20px;">
			{{ order.get_formatted_shipping_address() | raw }}
		</div>
	{% endif %}

	{# Payment Method #}
	{% set payment_method = order.get_payment_method_title() %}
	{% if payment_method %}
		<h3>Payment Method</h3>
		<p>{{ payment_method }}</p>
	{% endif %}

	{# Shipping Method #}
	{% set shipping_method = order.get_shipping_method() %}
	{% if shipping_method %}
		<h3>Shipping Method</h3>
		<p>{{ shipping_method }}</p>
	{% endif %}

	{# Admin Links #}
	<div style="margin-top: 30px; padding-top: 20px; border-top: 1px solid #dee2e6;">
		<a href="{{ admin_url('post.php?post=' ~ order.get_id() ~ '&action=edit') }}" class="button" style="display: inline-block; padding: 12px 24px; background-color: #0066cc; color: white; text-decoration: none; border-radius: 4px; font-weight: 600;">
			← View Order in Admin
		</a>
	</div>

	{% if additional_content %}
		<div style="margin-top: 20px; padding: 15px; background-color: #fff3cd; border-left: 4px solid #ffc107; border-radius: 4px;">
			<strong style="color: #856404;">Admin Note:</strong><br>
			{{ additional_content | raw }}
		</div>
	{% endif %}
{% endblock %}
