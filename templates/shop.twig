{#
  WooCommerce Shop Page Template
  Displays all products with filtering, breadcrumbs, and pagination
  
  Features:
  - Hero section with background image
  - Breadcrumb navigation
  - Product filtering sidebar
  - Responsive product grid (3/2/1 columns)
  - Sorting and view options
#}

{% extends "base.twig" %}

{% block content %}
	<div
		class="shop">

		{# Hero Section #}
		<div class="shop__hero">
			<div class="shop__hero-bg" style="background-image: url('{{ shop_hero_image }}')">
				<div class="shop__hero-overlay"></div>
				<div class="container">
					<div class="shop__hero-content">
						<h1 class="shop__hero-title">{{ shop_title }}</h1>
						{% if shop_description %}
							<p class="shop__hero-subtitle">{{ shop_description }}</p>
						{% endif %}
					</div>
				</div>
			</div>
		</div>


		{# Main shop content #}
		<div class="container">

			<div
				class="shop__wrapper">

				{# Sidebar with filters #}
				{% if sidebar %}
					<aside class="shop__sidebar">
						<div class="shop__sidebar-inner">
							<h3 class="shop__sidebar-title">{{ _e('Filter Products', 'starter-theme-1.x') }}</h3>
							{% include "sidebar.twig" %}

							{# WooCommerce filters #}
							{% do action('woocommerce_before_main_content') %}
						</div>
					</aside>
				{% endif %}

				{# Main shop content #}
				<main
					class="shop__main">

					{# Shop toolbar (sorting, view options) #}
					<div class="shop__toolbar">
						<div
							class="shop__toolbar-left">
							{# Results count #}
							<div class="shop__results-count">
								{% if posts %}
									Showing
									<strong>{{ posts|length }}</strong>
									{{ posts|length == 1 ? 'product' : 'products' }}
								{% endif %}
							</div>
						</div>

						<div
							class="shop__toolbar-right">{# Could add sorting here later #}
						</div>
					</div>

					{# Products grid #}
					{% if posts %}
						<div class="shop__products shop__products--grid">
							{% do action('woocommerce_before_shop_loop') %}

							{% for product in posts %}
								{% include "components/product-card.twig" with {
									product: product
								} %}
							{% endfor %}

							{% do action('woocommerce_after_shop_loop') %}
						</div>
					{% else %}
						<div class="shop__empty">
							<p>{{ _e('No products found', 'starter-theme-1.x') }}</p>
						</div>
					{% endif %}

					{# Pagination #}
					<nav class="shop__pagination">
						{{ posts_pagination }}
					</nav>

				</main>

			</div>

		</div>

	</div>
{% endblock %}
