{% extends "base.twig" %}

{% block content %}
	<div
		class="account-page">
		<!-- Header Section -->
		<div class="account-page__header">
			<div class="container">
				<h1 class="account-page__title">My Account</h1>
				<p class="account-page__subtitle">Manage your orders, downloads, and account settings</p>
			</div>
		</div>

		<!-- Main Content -->
		<div class="container">
			<div
				class="account-page__wrapper">
				<!-- Sidebar Navigation -->
				<aside class="account-page__sidebar">
					<nav class="account-page__nav">
						<a href="{{ function('wc_get_account_endpoint_url', 'dashboard') }}" class="account-page__nav-link account-page__nav-link--active">
							<svg width="20" height="20" viewbox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
								<path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
								<polyline points="9 22 9 12 15 12 15 22"></polyline>
							</svg>
							Dashboard
						</a>

						<a href="{{ function('wc_get_account_endpoint_url', 'orders') }}" class="account-page__nav-link">
							<svg width="20" height="20" viewbox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
								<circle cx="9" cy="21" r="1"></circle>
								<circle cx="20" cy="21" r="1"></circle>
								<path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
							</svg>
							Orders
							{% if order_count %}
								<span class="account-page__badge">{{ order_count }}</span>
							{% endif %}
						</a>

						<a href="{{ function('wc_get_account_endpoint_url', 'downloads') }}" class="account-page__nav-link">
							<svg width="20" height="20" viewbox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
								<polyline points="8 17 12 21 16 17"></polyline>
								<line x1="12" y1="12" x2="12" y2="21"></line>
								<path d="M20.88 18.09A5 5 0 0 0 18 9h-1.26A8 8 0 1 0 3 16.3"></path>
							</svg>
							Downloads
						</a>

						<a href="{{ function('wc_get_account_endpoint_url', 'edit-account') }}" class="account-page__nav-link">
							<svg width="20" height="20" viewbox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
								<path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
								<path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
							</svg>
							Account Settings
						</a>
						{% if wishlist_count is defined %}
							<a href="{{ wishlist_url }}" class="account-page__nav-link">
								<svg width="20" height="20" viewbox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
									<path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
								</svg>
								Wishlist
								{% if wishlist_count > 0 %}
									<span class="account-page__badge">{{ wishlist_count }}</span>
								{% endif %}
							</a>
						{% endif %}

						{% if comparison_count is defined %}
							<a href="{{ comparison_url }}" class="account-page__nav-link">
								<svg width="20" height="20" viewbox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
									<path d="M8 3h8M8 3v18M8 3H4m4 0h12v2H8v-2M8 9h12v2H8v-2M8 15h12v2H8v-2" stroke="currentColor"/>
								</svg>
								Compare
								{% if comparison_count > 0 %}
									<span class="account-page__badge">{{ comparison_count }}</span>
								{% endif %}
							</a>
						{% endif %}
						<a href="{{ function('wp_logout_url', function('home_url')) }}" class="account-page__nav-link account-page__nav-link--logout">
							<svg width="20" height="20" viewbox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
								<path d="M10 3H6a2 2 0 0 0-2 2v14c0 1.1.9 2 2 2h4"></path>
								<polyline points="17 16 21 12 17 8"></polyline>
								<line x1="21" y1="12" x2="9" y2="12"></line>
							</svg>
							Logout
						</a>
					</nav>
				</aside>

				<!-- Main Content Area -->
				<main
					class="account-page__main">
					<!-- Welcome Section -->
					<section class="account-page__section">
						<div class="account-page__welcome">
							<h2>Welcome back,
								<strong>{{ customer.display_name }}!</strong>
							</h2>
							<p>Here's what's been happening with your account:</p>
						</div>
					</section>

					<!-- Stats Cards -->
					<section class="account-page__stats">
						<div class="account-page__stat-card">
							<div class="account-page__stat-icon account-page__stat-icon--orders">
								<svg width="24" height="24" viewbox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
									<circle cx="9" cy="21" r="1"></circle>
									<circle cx="20" cy="21" r="1"></circle>
									<path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
								</svg>
							</div>
							<div class="account-page__stat-content">
								<h3>Total Orders</h3>
								<p class="account-page__stat-number">{{ order_count|default(0) }}</p>
							</div>
						</div>

						<div class="account-page__stat-card">
							<div class="account-page__stat-icon account-page__stat-icon--account">
								<svg width="24" height="24" viewbox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
									<path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
									<circle cx="12" cy="7" r="4"></circle>
								</svg>
							</div>
							<div class="account-page__stat-content">
								<h3>Member Since</h3>
								<p class="account-page__stat-value">{{ customer.user_registered|date('M Y') }}</p>
							</div>
						</div>

						<div class="account-page__stat-card">
							<div class="account-page__stat-icon account-page__stat-icon--mail">
								<svg width="24" height="24" viewbox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
									<rect x="2" y="4" width="20" height="16" rx="2"></rect>
									<path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
								</svg>
							</div>
							<div class="account-page__stat-content">
								<h3>Email</h3>
								<p class="account-page__stat-value">{{ customer.user_email }}</p>
							</div>
						</div>
					</section>

					<!-- Recent Orders Section -->
					<section class="account-page__section">
						<div class="account-page__section-header">
							<h2 class="account-page__section-title">Recent Orders</h2>
							<a href="{{ function('wc_get_account_endpoint_url', 'orders') }}" class="account-page__section-link">View All Orders →</a>
						</div>

						{% if customer_orders %}
							<div class="account-page__orders">
								{% for order in customer_orders|slice(0, 5) %}
									<div class="account-page__order-card">
										<div class="account-page__order-card-header">
											<div>
												<h3 class="account-page__order-number">Order #{{ order.get_order_number() }}</h3>
												<p class="account-page__order-date">{{ order.get_date_created()|date('F d, Y') }}</p>
											</div>
											<span class="account-page__order-status account-page__order-status--{{ order.get_status() }}">
												{{ order.get_status()|replace({'_': ' '})|title }}
											</span>
										</div>

										<div class="account-page__order-card-body">
											<div class="account-page__order-info">
												<strong>{{ order.get_item_count() }}
													Item{{ order.get_item_count() != 1 ? 's' : '' }}</strong>
												<span>{{ order.get_total()|wc_price }}</span>
											</div>

											<a href="{{ function('wc_get_account_endpoint_url', 'view-order') }}/{{ order.get_id() }}/" class="account-page__order-link">
												View Details →
											</a>
										</div>
									</div>
								{% endfor %}
							</div>
						{% else %}
							<div class="account-page__empty-state">
								<svg width="48" height="48" viewbox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" opacity="0.5">
									<circle cx="9" cy="21" r="1"></circle>
									<circle cx="20" cy="21" r="1"></circle>
									<path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
								</svg>
								<h3>No orders yet</h3>
								<p>You haven't placed any orders yet. Start shopping to see your orders here.</p>
								<a href="{{ function('wc_get_page_permalink', 'shop') }}" class="account-page__btn account-page__btn--primary">
									Browse Products
								</a>
							</div>
						{% endif %}
					</section>

					<!-- Account Information Section -->
					<section class="account-page__section">
						<h2 class="account-page__section-title">Account Information</h2>

						<div class="account-page__info-grid">
							<div class="account-page__info-block">
								<h3>Contact Information</h3>
								<dl class="account-page__dl">
									<dt>Email:</dt>
									<dd>
										{{ customer.user_email }}
										<a href="{{ function('wc_get_account_endpoint_url', 'edit-account') }}" class="account-page__edit-link">(Edit)</a>
									</dd>

									{% if customer.billing_phone %}
										<dt>Phone:</dt>
										<dd>{{ customer.billing_phone }}</dd>
									{% endif %}
								</dl>
							</div>

							<div class="account-page__info-block">
								<h3>Billing Address</h3>
								{% if customer.billing_first_name %}
									<address class="account-page__address">
										{{ customer.billing_first_name }}
										{{ customer.billing_last_name }}<br>
										{{ customer.billing_address_1 }}<br>
										{% if customer.billing_address_2 %}
											{{ customer.billing_address_2 }}<br>
										{% endif %}
										{{ customer.billing_city }},
										{{ customer.billing_state }}
										{{ customer.billing_postcode }}<br>
										{{ customer.billing_country }}
									</address>
									<a href="{{ function('wc_get_account_endpoint_url', 'edit-address') }}" class="account-page__edit-link">Edit Address</a>
								{% else %}
									<p>No billing address on file.</p>
									<a href="{{ function('wc_get_account_endpoint_url', 'edit-address') }}" class="account-page__btn account-page__btn--small">
										Add Address
									</a>
								{% endif %}
							</div>
						</div>
					</section>

					<!-- Security Section -->
					<section class="account-page__section">
						<h2 class="account-page__section-title">Account Security</h2>

						<div class="account-page__security">
							<div class="account-page__security-item">
								<div>
									<h3>Password</h3>
									<p>Protect your account with a strong password.</p>
								</div>
								<a href="{{ function('wc_get_account_endpoint_url', 'edit-account') }}" class="account-page__btn account-page__btn--small">
									Change Password
								</a>
							</div>

							<div class="account-page__security-item">
								<div>
									<h3>Two-Factor Authentication</h3>
									<p>Add an extra layer of security to your account.</p>
								</div>
								<button class="account-page__btn account-page__btn--small account-page__btn--disabled" disabled>
									Coming Soon
								</button>
							</div>
						</div>
					</section>
				</main>
			</div>
		</div>
	</div>
{% endblock %}
