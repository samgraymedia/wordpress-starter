{#
  User Account Component
  Displays user login/logout section in header
#}

{% if is_user_logged_in %}
	<li class="nav-menu__item nav-menu__item--account">
		<a href="{{ site.url }}/account" class="nav-menu__link nav-menu__link--account">
			{{ _e('My Account', 'starter-theme-1.x') }}
		</a>
	</li>
	<li class="nav-menu__item nav-menu__item--logout">
		<a href="{{ wp_logout_url(site.url) }}" class="nav-menu__link nav-menu__link--logout">
			{{ _e('Logout', 'starter-theme-1.x') }}
		</a>
	</li>
{% else %}
	<li class="nav-menu__item nav-menu__item--login">
		<a href="{{ site.url }}/login" class="nav-menu__link nav-menu__link--login">
			{{ _e('Login', 'starter-theme-1.x') }}
		</a>
	</li>
	{% if get_option('users_can_register') %}
		<li class="nav-menu__item nav-menu__item--register">
			<a href="{{ site.url }}/register" class="nav-menu__link nav-menu__link--register">
				{{ _e('Register', 'starter-theme-1.x') }}
			</a>
		</li>
	{% endif %}
{% endif %}
