{#
  User Account Component
  Displays user login/logout section in header
#}

<div class="user-account">
	{% if is_user_logged_in %}
		<div class="user-account__logged-in">
			<span class="user-account__greeting">
				{{ _e('Hello,', 'starter-theme-1.x') }}
				<strong>{{ user.display_name }}</strong>
			</span>
			<div class="user-account__actions">
				<a href="{{ site.url }}/wp-admin" class="user-account__link user-account__link--account">
					{{ _e('My Account', 'starter-theme-1.x') }}
				</a>
				|
				<a href="{{ wp_logout_url(site.url) }}" class="user-account__link user-account__link--logout">
					{{ _e('Logout', 'starter-theme-1.x') }}
				</a>
			</div>
		</div>
	{% else %}
		<div class="user-account__logged-out">
			<a href="{{ site.url }}/login" class="user-account__link user-account__link--login">
				{{ _e('Login', 'starter-theme-1.x') }}
			</a>
			{% if get_option('users_can_register') %}
				|
				<a href="{{ site.url }}/register" class="user-account__link user-account__link--register">
					{{ _e('Register', 'starter-theme-1.x') }}
				</a>
			{% endif %}
		</div>
	{% endif %}
</div>
