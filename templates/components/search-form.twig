{#
  Search Form Component
  Displays a product search form for the store
#}

<form role="search" method="get" class="search-form" action="{{ site.url }}">
	<label for="search-input" class="search-form__label">
		{{ _e('Search products...', 'starter-theme-1.x') }}
	</label>
	<div class="search-form__wrapper">
		<input type="search" id="search-input" required class="search-form__input" placeholder="{{ _e('Search by product name...', 'starter-theme-1.x') }}" value="{{ get_search_query() }}" name="s" title="{{ _e('Search for', 'starter-theme-1.x') }}"/>
		<input type="hidden" name="post_type" value="product"/>
		<button type="submit" class="search-form__button">
			{{ _e('Search', 'starter-theme-1.x') }}
		</button>
	</div>
</form>
