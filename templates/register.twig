{#
  Registration Page Template
  Custom WordPress registration form
#}

{% extends "base.twig" %}

{% block content %}
<div class="register-container">
	<div class="register-box">
		<div class="register-header">
			<h1 class="register-title">{{ _e('Create Your Account', 'starter-theme-1.x') }}</h1>
			<p class="register-subtitle">{{ _e('Join our community and start shopping', 'starter-theme-1.x') }}</p>
		</div>

		{% if error_message %}
			<div class="alert alert--error">
				{{ error_message }}
			</div>
		{% endif %}

		{% if success_message %}
			<div class="alert alert--success">
				{{ success_message }}
			</div>
		{% endif %}

		<form method="post" class="register-form" action="{{ site.url }}/register">
			<div class="form-group">
				<label for="user_email" class="form-label">{{ _e('Email Address', 'starter-theme-1.x') }}<span class="required">*</span>
				</label>
				<input type="email" name="email" id="user_email" class="form-input" placeholder="{{ _e('your@email.com', 'starter-theme-1.x') }}" required autofocus/>
				<small class="form-help">{{ _e('Your email will be your username', 'starter-theme-1.x') }}</small>
			</div>

			<div class="form-group">
				<label for="first_name" class="form-label">{{ _e('First Name', 'starter-theme-1.x') }}</label>
				<input type="text" name="first_name" id="first_name" class="form-input" placeholder="{{ _e('John', 'starter-theme-1.x') }}"/>
			</div>

			<div class="form-group">
				<label for="last_name" class="form-label">{{ _e('Last Name', 'starter-theme-1.x') }}</label>
				<input type="text" name="last_name" id="last_name" class="form-input" placeholder="{{ _e('Doe', 'starter-theme-1.x') }}"/>
			</div>

			<div class="form-group">
				<label for="user_pass" class="form-label">{{ _e('Password', 'starter-theme-1.x') }}<span class="required">*</span>
				</label>
				<input type="password" name="password" id="user_pass" class="form-input" placeholder="{{ _e('Create a strong password', 'starter-theme-1.x') }}" required minlength="8"/>
				<small class="form-help">{{ _e('Minimum 8 characters', 'starter-theme-1.x') }}</small>
			</div>

			<div class="form-group">
				<label for="user_pass_confirm" class="form-label">{{ _e('Confirm Password', 'starter-theme-1.x') }}<span class="required">*</span>
				</label>
				<input type="password" name="password_confirm" id="user_pass_confirm" class="form-input" placeholder="{{ _e('Confirm your password', 'starter-theme-1.x') }}" required minlength="8"/>
			</div>

			<div class="form-group form-group--checkbox">
				<input type="checkbox" name="agree_terms" id="agree_terms" value="yes" class="form-checkbox" required/>
				<label for="agree_terms" class="form-checkbox-label">
					{{ _e('I agree to the Terms of Service', 'starter-theme-1.x') }}
					<span class="required">*</span>
				</label>
			</div>

			{{ wp_nonce_field('register_nonce', '_register_nonce') }}

			{% include 'components/button.twig' with {
				text: _e('Create Account', 'starter-theme-1.x'),
			class: 'btn--primary btn--large'

			<div class="register-footer">
				<p class="register-footer__text">
					{{ _e('Already have an account?', 'starter-theme-1.x') }}
					<a href="{{ site.url }}/login" class="register-footer__link">
						{{ _e('Login here', 'starter-theme-1.x') }}
					</a>
				</p>
			</div>
		</div>
	</div>
{% endblock %}
