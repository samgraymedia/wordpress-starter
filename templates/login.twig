{#
  Login Page Template
  Custom WordPress login form
#}

{% extends "base.twig" %}

{% block content %}
	<div class="login-container">
		<div class="login-box">
			<div class="login-header">
				<h1 class="login-title">{{ _e('Login to Your Account', 'starter-theme-1.x') }}</h1>
				<p class="login-subtitle">{{ _e('Enter your credentials to access your account', 'starter-theme-1.x') }}</p>
			</div>

			<form method="post" class="login-form" role="form">
				<div class="form-group">
					<label for="user_login" class="form-label">{{ _e('Email or Username', 'starter-theme-1.x') }}</label>
					<input type="text" name="log" id="user_login" class="form-input" placeholder="{{ _e('Enter your email or username', 'starter-theme-1.x') }}" aria-describedby="login-error" required autofocus/>
					<div id="login-error" class="form-error" role="alert" aria-live="polite"></div>
				</div>

				<div class="form-group">
					<label for="user_pass" class="form-label">{{ _e('Password', 'starter-theme-1.x') }}</label>
					<div class="form-password-wrapper">
						<input type="password" name="pwd" id="user_pass" class="form-input" placeholder="{{ _e('Enter your password', 'starter-theme-1.x') }}" aria-describedby="password-error" required/>
						<button type="button" class="form-password-toggle" aria-label="Show password" aria-pressed="false" data-toggle-password="user_pass" title="Toggle password visibility">
							<svg class="icon-show" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>
							<svg class="icon-hide" style="display:none;" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path><line x1="1" y1="1" x2="23" y2="23"></line></svg>
						</button>
					</div>
					<div id="password-error" class="form-error" role="alert" aria-live="polite"></div>
				</div>

				<div class="form-group form-group--checkbox">
					<input type="checkbox" name="rememberme" id="rememberme" value="forever" class="form-checkbox"/>
					<label for="rememberme" class="form-checkbox-label">
						{{ _e('Remember me', 'starter-theme-1.x') }}
					</label>
				</div>

				<button type="submit" class="btn btn--primary btn--large">
					{{ _e('Login', 'starter-theme-1.x') }}
				</button>

				<input type="hidden" name="redirect_to" value="{{ site.url }}/shop"/>
			</form>

			<div class="login-footer">
				<p class="login-footer__text">
					{{ _e("Don't have an account?", 'starter-theme-1.x') }}
					<a href="{{ site.url }}/register" class="login-footer__link">
						{{ _e('Create one here', 'starter-theme-1.x') }}
					</a>
				</p>
				<p class="login-footer__text">
					<a href="{{ site.url }}/wp-login.php?action=lostpassword" class="login-footer__link">
						{{ _e('Forgot your password?', 'starter-theme-1.x') }}
					</a>
				</p>
			</div>
		</div>
	</div>
{% endblock %}
