{% if items %}
	<ul class="nav-menu">
		<li>
			<h3 class="header__logo">
				<a class="header__logo-link" href="{{site.url}}" rel="home">{{site.name}}</a>
			</h3>
		</li>
		{% for item in items %}

			<li class="nav-menu__item {{ item.classes | join(' ') }}">
				<a href="{{ item.link }}" class="nav-menu__link" {% if item.current %} aria-current="page" {% endif %} {% if item.children %} aria-expanded="false" aria-haspopup="true" {% endif %} {% if item.target == '_blank' %} target="_blank" rel="noopener noreferrer" {% endif %}>
					{{ item.title }}
				</a>
				{% if item.children %}
					<ul class="nav-menu__submenu" aria-label="{{ _e('Submenu') }}">
						{% include "menu.twig" with {'items': item.children} %}
					</ul>
				{% endif %}
			</li>
		{% endfor %}
	</ul>
{% endif %}
